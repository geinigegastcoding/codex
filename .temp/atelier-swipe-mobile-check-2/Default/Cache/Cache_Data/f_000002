:root {
  --paper: #f3f0e9;
  --paper-light: #fcfaf5;
  --paper-deep: #e5ded1;
  --ink: #1e2b31;
  --muted: #718087;
  --line: rgba(30, 43, 49, 0.14);
  --blue: #355b70;
  --blue-deep: #183746;
  --coral: #e6765d;
  --yellow: #efc960;
  --sage: #7c9b8d;
  --display: "Playfair Display", Georgia, serif;
  --body: "DM Sans", "Segoe UI", sans-serif;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  min-width: 320px;
  margin: 0;
  color: var(--ink);
  background:
    radial-gradient(circle at 16% 18%, rgba(255, 255, 255, 0.82), transparent 28rem),
    radial-gradient(circle at 89% 70%, rgba(212, 224, 219, 0.5), transparent 31rem),
    var(--paper);
  font-family: var(--body);
  -webkit-font-smoothing: antialiased;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
  font: inherit;
}

button:focus-visible,
a:focus-visible {
  outline: 3px solid var(--coral);
  outline-offset: 4px;
}

.grain {
  position: fixed;
  z-index: 20;
  inset: 0;
  pointer-events: none;
  opacity: 0.24;
  mix-blend-mode: multiply;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.18'/%3E%3C/svg%3E");
}

.app-shell {
  width: min(100%, 1500px);
  min-height: 100vh;
  margin: 0 auto;
  overflow-x: hidden;
  padding: 0 5vw;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104px;
  border-bottom: 1px solid var(--line);
}

.wordmark {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  color: var(--ink);
  text-decoration: none;
}

.wordmark-mark {
  position: relative;
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border: 1px solid var(--ink);
  border-radius: 50%;
  transform: rotate(-18deg);
}

.wordmark-mark::before,
.wordmark-mark::after {
  position: absolute;
  content: "";
  width: 16px;
  height: 1px;
  background: var(--ink);
}

.wordmark-mark::after {
  transform: rotate(90deg);
}

.wordmark-mark span {
  position: relative;
  z-index: 1;
  display: block;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--coral);
}

.wordmark-mark span:nth-child(2) {
  position: absolute;
  top: 5px;
  right: 5px;
  width: 3px;
  height: 3px;
  background: var(--yellow);
}

.wordmark-mark span:nth-child(3) {
  position: absolute;
  bottom: 6px;
  left: 6px;
  width: 3px;
  height: 3px;
  background: var(--blue);
}

.wordmark-copy {
  font-size: 0.96rem;
  font-weight: 700;
  letter-spacing: -0.045em;
}

.wordmark-copy span {
  color: var(--coral);
  font-weight: 500;
}

.topnav {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-left: 9%;
}

.nav-tab,
.profile-trigger,
.text-button {
  border: 0;
  background: transparent;
  cursor: pointer;
}

.nav-tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 0;
  color: var(--muted);
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.02em;
  transition: color 180ms ease;
}

.nav-tab::after {
  position: absolute;
  right: 0;
  bottom: -1px;
  left: 0;
  height: 2px;
  content: "";
  background: var(--coral);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 180ms ease;
}

.nav-tab:hover,
.nav-tab.is-active {
  color: var(--ink);
}

.nav-tab.is-active::after {
  transform: scaleX(1);
}

.nav-count {
  display: inline-grid;
  place-items: center;
  min-width: 21px;
  height: 21px;
  padding: 0 5px;
  border-radius: 999px;
  color: var(--blue-deep);
  background: rgba(53, 91, 112, 0.1);
  font-size: 0.67rem;
  font-weight: 700;
}

.profile-trigger {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 8px 0;
  color: var(--blue-deep);
  font-size: 0.75rem;
  font-weight: 700;
}

.profile-trigger svg {
  width: 14px;
  transition: transform 180ms ease;
}

.profile-trigger:hover svg {
  transform: translateY(2px);
}

.profile-orbit {
  position: relative;
  display: inline-grid;
  place-items: center;
  width: 27px;
  height: 27px;
  border: 1px solid var(--blue);
  border-radius: 50%;
}

.profile-orbit::before,
.profile-orbit::after {
  position: absolute;
  content: "";
  border-radius: 50%;
}

.profile-orbit::before {
  width: 6px;
  height: 6px;
  background: var(--coral);
}

.profile-orbit::after {
  width: 35px;
  height: 12px;
  border-top: 1px solid var(--blue);
  border-bottom: 1px solid var(--blue);
  transform: rotate(-35deg);
}

.profile-orbit span {
  position: absolute;
  top: 2px;
  right: 2px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--yellow);
}

.view {
  animation: view-in 420ms ease both;
}

.is-hidden {
  display: none !important;
}

.discover-view {
  display: grid;
  grid-template-columns: minmax(220px, 0.78fr) minmax(420px, 1fr) minmax(180px, 0.62fr);
  gap: clamp(36px, 7vw, 125px);
  align-items: center;
  min-height: calc(100vh - 170px);
  padding: 50px 0 75px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 9px;
  margin: 0 0 19px;
  color: var(--coral);
  font-size: 0.66rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.eyebrow span {
  display: inline-block;
  width: 29px;
  height: 1px;
  background: currentColor;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2 {
  font-family: var(--display);
  font-weight: 600;
  letter-spacing: -0.065em;
}

h1 {
  max-width: 450px;
  margin-bottom: 25px;
  font-size: clamp(3.2rem, 5.3vw, 5.2rem);
  line-height: 0.97;
}

h1 em {
  color: var(--coral);
  font-style: italic;
  white-space: nowrap;
}

.intro-copy {
  max-width: 310px;
  margin-bottom: 42px;
  color: var(--muted);
  font-size: 0.93rem;
  line-height: 1.75;
}

.micro-legend {
  display: grid;
  gap: 13px;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 11px;
  color: var(--muted);
  font-size: 0.73rem;
}

.legend-icon {
  display: inline-grid;
  place-items: center;
  width: 25px;
  height: 25px;
  border: 1px solid currentColor;
  border-radius: 50%;
  font-family: var(--display);
  font-size: 1rem;
  line-height: 1;
}

.legend-icon-no {
  color: var(--blue);
}

.legend-icon-yes {
  color: var(--coral);
  font-size: 0.78rem;
}

.swipe-column {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  min-width: 0;
}

.progress-row {
  display: flex;
  justify-content: space-between;
  width: 100%;
  max-width: 460px;
  margin-bottom: 15px;
  color: var(--blue-deep);
  font-size: 0.67rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.progress-copy {
  color: var(--muted);
  font-weight: 500;
  letter-spacing: 0;
  text-transform: none;
}

.card-stack {
  position: relative;
  width: 100%;
  max-width: 455px;
  aspect-ratio: 0.79;
  margin: 0 auto;
}

.painting-card {
  --card-angle: 0deg;
  position: absolute;
  inset: 0;
  padding: 10px;
  overflow: hidden;
  border: 1px solid rgba(30, 43, 49, 0.12);
  border-radius: 18px;
  background: var(--paper-light);
  box-shadow: 0 19px 42px rgba(30, 43, 49, 0.12), 0 3px 8px rgba(30, 43, 49, 0.07);
}

.painting-card::before {
  position: absolute;
  z-index: 4;
  top: 18px;
  left: 18px;
  padding: 6px 9px;
  border-radius: 99px;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(24, 55, 70, 0.58);
  content: "NIEUWE ONTDEKKING";
  font-size: 0.54rem;
  font-weight: 700;
  letter-spacing: 0.11em;
}

.painting-card.back {
  z-index: 0;
  background: #d7dfd8;
  transform: translate(13px, 14px) rotate(3.4deg) scale(0.97);
}

.painting-card.back::after {
  position: absolute;
  right: 28px;
  bottom: 28px;
  left: 28px;
  height: 35%;
  border-radius: 55% 40% 10% 20%;
  background: rgba(255, 255, 255, 0.35);
  content: "";
  filter: blur(3px);
}

.painting-card.current {
  z-index: 2;
  cursor: grab;
  touch-action: pan-y;
  transform: translateX(var(--drag-x, 0px)) rotate(var(--card-angle));
  transition: transform 180ms ease, box-shadow 180ms ease;
}

.painting-card.current.is-dragging {
  cursor: grabbing;
  transition: none;
}

.painting-card.current:hover {
  --card-angle: -0.7deg;
  box-shadow: 0 25px 48px rgba(30, 43, 49, 0.16), 0 4px 10px rgba(30, 43, 49, 0.09);
}

.painting-card.current:active {
  cursor: grabbing;
}

.painting-card.is-swiping-left {
  animation: swipe-left 370ms cubic-bezier(0.6, -0.05, 0.4, 1) forwards;
}

.painting-card.is-swiping-right {
  animation: swipe-right 370ms cubic-bezier(0.6, -0.05, 0.4, 1) forwards;
}

.painting-card.is-swiping-left::before,
.painting-card.is-swiping-right::before {
  position: absolute;
  z-index: 6;
  top: 27px;
  right: 22px;
  left: auto;
  padding: 8px 11px;
  font-family: var(--body);
  font-size: 0.63rem;
  letter-spacing: 0.11em;
}

.painting-card.is-swiping-left::before {
  color: var(--blue-deep);
  background: var(--paper-light);
  content: "PASS";
  transform: rotate(10deg);
}

.painting-card.is-swiping-right::before {
  color: #fffaf2;
  background: var(--coral);
  content: "BEWAARD";
  transform: rotate(-10deg);
}

.painting-art {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: 11px;
  background: var(--art-fallback, linear-gradient(140deg, #e67c5b 3%, #f0c864 42%, #355b70 100%));
}

.painting-art::after {
  position: absolute;
  z-index: 1;
  inset: 0;
  background: linear-gradient(180deg, rgba(15, 37, 47, 0.04) 45%, rgba(15, 37, 47, 0.74) 100%);
  content: "";
  pointer-events: none;
}

.painting-art.image-failed img {
  display: none;
}

.saved-card-art.image-failed img {
  display: none;
}

.painting-art.image-failed::before {
  position: absolute;
  z-index: 0;
  inset: 0;
  background:
    radial-gradient(circle at 19% 26%, rgba(255, 241, 193, 0.9) 0 8%, transparent 9%),
    radial-gradient(ellipse at 74% 36%, rgba(54, 92, 111, 0.8) 0 20%, transparent 21%),
    radial-gradient(ellipse at 35% 76%, rgba(228, 110, 84, 0.9) 0 22%, transparent 23%),
    var(--art-fallback);
  content: "";
}

.painting-art img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
}

.painting-card.current:hover .painting-art img {
  transform: scale(1.035);
}

.card-topline,
.card-caption {
  position: absolute;
  z-index: 2;
  right: 25px;
  left: 25px;
}

.card-topline {
  top: 27px;
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.8);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.card-topline .card-index {
  opacity: 0.72;
}

.card-caption {
  bottom: 24px;
  color: #fffaf2;
}

.card-caption .card-artist {
  margin: 0 0 2px;
  font-size: 0.68rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  opacity: 0.74;
  text-transform: uppercase;
}

.card-caption h3 {
  max-width: 87%;
  margin: 0;
  font-family: var(--display);
  font-size: clamp(1.7rem, 3.2vw, 2.4rem);
  font-weight: 600;
  letter-spacing: -0.055em;
  line-height: 1.03;
}

.card-caption .card-meta {
  display: flex;
  gap: 7px;
  margin-top: 11px;
  font-size: 0.66rem;
  opacity: 0.8;
}

.card-caption .card-meta span + span::before {
  margin-right: 7px;
  content: "·";
}

.action-row {
  display: flex;
  align-items: center;
  gap: 18px;
  margin-top: 27px;
}

.action-button {
  display: inline-grid;
  place-items: center;
  width: 55px;
  height: 55px;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: rgba(252, 250, 245, 0.65);
  cursor: pointer;
  transition: transform 170ms ease, box-shadow 170ms ease, background 170ms ease, color 170ms ease;
}

.action-button:hover:not(:disabled) {
  transform: translateY(-3px);
  box-shadow: 0 8px 18px rgba(30, 43, 49, 0.12);
}

.action-button:active:not(:disabled) {
  transform: translateY(0) scale(0.95);
}

.action-button:disabled {
  cursor: not-allowed;
  opacity: 0.36;
}

.action-button svg {
  width: 22px;
  height: 22px;
}

.action-button-pass {
  color: var(--blue);
}

.action-button-pass:hover:not(:disabled) {
  color: var(--paper-light);
  background: var(--blue);
}

.action-button-undo {
  width: 41px;
  height: 41px;
  color: var(--muted);
}

.action-button-undo svg {
  width: 18px;
  height: 18px;
}

.action-button-like {
  color: var(--coral);
}

.action-button-like:hover:not(:disabled) {
  color: var(--paper-light);
  background: var(--coral);
}

.shortcut-hint {
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 0.62rem;
}

.deck-finished {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 28px;
  border: 1px solid var(--line);
  border-radius: 18px;
  background: rgba(252, 250, 245, 0.72);
  box-shadow: 0 19px 42px rgba(30, 43, 49, 0.09);
  text-align: center;
}

.deck-finished .eyebrow {
  margin-bottom: 13px;
}

.deck-finished h3 {
  margin-bottom: 11px;
  font-family: var(--display);
  font-size: 2.35rem;
  font-weight: 600;
  letter-spacing: -0.06em;
}

.deck-finished > p:not(.eyebrow) {
  max-width: 250px;
  margin-bottom: 23px;
  color: var(--muted);
  font-size: 0.77rem;
  line-height: 1.65;
}

.deck-finished > p strong {
  color: var(--blue-deep);
}

.finished-orbit {
  position: relative;
  display: grid;
  place-items: center;
  width: 72px;
  height: 72px;
  margin-bottom: 25px;
  border: 1px solid var(--blue);
  border-radius: 50%;
}

.finished-orbit::before,
.finished-orbit::after {
  position: absolute;
  width: 105px;
  height: 29px;
  border: 1px solid rgba(53, 91, 112, 0.4);
  border-radius: 50%;
  content: "";
}

.finished-orbit::before {
  transform: rotate(34deg);
}

.finished-orbit::after {
  transform: rotate(-34deg);
}

.finished-orbit span {
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: var(--coral);
}

.shortcut-hint span {
  padding: 0 8px;
  color: var(--paper-deep);
}

kbd {
  display: inline-block;
  min-width: 17px;
  padding: 2px 4px;
  border: 1px solid rgba(30, 43, 49, 0.18);
  border-bottom-width: 2px;
  border-radius: 4px;
  background: rgba(255, 255, 255, 0.36);
  font-family: var(--body);
  font-size: 0.58rem;
  text-align: center;
}

.side-column {
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 19px 0 36px;
}

.side-note {
  max-width: 170px;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

.note-index {
  display: block;
  margin-bottom: 12px;
  color: var(--coral);
  font-family: var(--display);
  font-size: 1.5rem;
  font-style: italic;
}

.side-note p {
  margin: 0;
  color: var(--muted);
  font-size: 0.7rem;
  line-height: 1.65;
}

.side-note-bottom {
  align-self: flex-end;
}

.side-note-bottom .note-index {
  color: var(--blue);
  font-family: var(--body);
  font-size: 0.61rem;
  font-style: normal;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 24px;
  padding: 65px 0 34px;
}

.section-heading h2 {
  max-width: 620px;
  margin: 0;
  font-size: clamp(2.5rem, 5vw, 4.8rem);
  line-height: 0.98;
}

.text-button {
  display: inline-flex;
  align-items: center;
  gap: 13px;
  flex: 0 0 auto;
  padding: 8px 0;
  color: var(--blue);
  font-size: 0.72rem;
  font-weight: 700;
}

.text-button span {
  font-size: 1.15rem;
  font-weight: 400;
  transition: transform 180ms ease;
}

.text-button:hover span {
  transform: translateX(4px);
}

.profile-view,
.saved-view {
  min-height: calc(100vh - 170px);
  padding-bottom: 80px;
}

.profile-panel {
  display: grid;
  grid-template-columns: minmax(240px, 0.78fr) minmax(300px, 1.22fr);
  overflow: hidden;
  border-radius: 20px;
  background: var(--blue-deep);
  box-shadow: 0 18px 40px rgba(24, 55, 70, 0.14);
}

.profile-art {
  position: relative;
  min-height: 450px;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 30% 26%, var(--coral) 0 16%, transparent 17%),
    radial-gradient(ellipse at 79% 36%, var(--yellow) 0 21%, transparent 22%),
    radial-gradient(ellipse at 38% 87%, var(--sage) 0 28%, transparent 29%),
    linear-gradient(135deg, #294f62, #102b38 75%);
}

.profile-art::before,
.profile-art::after {
  position: absolute;
  border: 1px solid rgba(255, 250, 242, 0.4);
  border-radius: 50%;
  content: "";
}

.profile-art::before {
  top: 13%;
  left: 11%;
  width: 78%;
  height: 50%;
  transform: rotate(-19deg);
}

.profile-art::after {
  right: -24%;
  bottom: 8%;
  width: 93%;
  height: 54%;
  border-color: rgba(255, 250, 242, 0.2);
  transform: rotate(27deg);
}

.profile-art-label {
  position: absolute;
  z-index: 1;
  right: 29px;
  bottom: 28px;
  left: 29px;
  color: #fffaf2;
}

.profile-art-label span {
  display: block;
  margin-bottom: 9px;
  color: rgba(255, 250, 242, 0.65);
  font-size: 0.59rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.profile-art-label strong {
  display: block;
  font-family: var(--display);
  font-size: clamp(2.2rem, 5vw, 4.6rem);
  font-weight: 600;
  letter-spacing: -0.07em;
  line-height: 0.9;
}

.profile-summary {
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(32px, 5vw, 74px);
  color: #fffaf2;
}

.profile-summary .eyebrow {
  color: var(--yellow);
}

.profile-summary h3 {
  max-width: 440px;
  margin: 0 0 20px;
  font-family: var(--display);
  font-size: clamp(2.4rem, 4.3vw, 4rem);
  font-weight: 600;
  letter-spacing: -0.065em;
  line-height: 0.99;
}

.profile-summary > p {
  max-width: 430px;
  margin-bottom: 28px;
  color: rgba(255, 250, 242, 0.72);
  font-size: 0.88rem;
  line-height: 1.75;
}

.profile-tags,
.palette-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.profile-tag {
  padding: 7px 10px;
  border: 1px solid rgba(255, 250, 242, 0.22);
  border-radius: 99px;
  color: rgba(255, 250, 242, 0.82);
  font-size: 0.63rem;
}

.profile-footnote {
  display: flex;
  align-items: center;
  gap: 19px;
  margin-top: 45px;
  padding-top: 18px;
  border-top: 1px solid rgba(255, 250, 242, 0.16);
  color: rgba(255, 250, 242, 0.55);
  font-size: 0.66rem;
}

.profile-footnote strong {
  color: var(--yellow);
  font-size: 1.2rem;
  font-weight: 500;
}

.profile-empty {
  display: grid;
  place-items: center;
  min-height: 430px;
  border: 1px dashed rgba(30, 43, 49, 0.22);
  border-radius: 20px;
  background: rgba(252, 250, 245, 0.42);
  text-align: center;
}

.profile-empty-inner {
  max-width: 330px;
  padding: 32px;
}

.empty-orbit {
  position: relative;
  display: grid;
  place-items: center;
  width: 70px;
  height: 70px;
  margin: 0 auto 24px;
  border: 1px solid var(--blue);
  border-radius: 50%;
}

.empty-orbit::before,
.empty-orbit::after {
  position: absolute;
  width: 98px;
  height: 28px;
  border: 1px solid rgba(53, 91, 112, 0.5);
  border-radius: 50%;
  content: "";
}

.empty-orbit::before {
  transform: rotate(36deg);
}

.empty-orbit::after {
  transform: rotate(-36deg);
}

.empty-orbit span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--coral);
}

.profile-empty h3 {
  margin-bottom: 10px;
  font-family: var(--display);
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.06em;
}

.profile-empty p {
  margin-bottom: 25px;
  color: var(--muted);
  font-size: 0.8rem;
  line-height: 1.65;
}

.primary-button {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 13px 18px;
  border: 0;
  border-radius: 99px;
  color: #fffaf2;
  background: var(--blue-deep);
  cursor: pointer;
  font-size: 0.7rem;
  font-weight: 700;
}

.primary-button:hover {
  background: var(--blue);
}

.saved-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 19px;
}

.saved-card {
  position: relative;
  overflow: hidden;
  min-height: 390px;
  border-radius: 15px;
  background: var(--paper-light);
  box-shadow: 0 9px 23px rgba(30, 43, 49, 0.08);
}

.saved-card-art {
  position: relative;
  height: 282px;
  overflow: hidden;
  background: var(--art-fallback);
}

.saved-card-art::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 52%, rgba(15, 37, 47, 0.35) 100%);
  content: "";
}

.saved-card-art img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 600ms ease;
}

.saved-card:hover .saved-card-art img {
  transform: scale(1.05);
}

.remove-save {
  position: absolute;
  z-index: 2;
  top: 13px;
  right: 13px;
  display: grid;
  place-items: center;
  width: 32px;
  height: 32px;
  border: 1px solid rgba(255, 250, 242, 0.38);
  border-radius: 50%;
  color: #fffaf2;
  background: rgba(24, 55, 70, 0.5);
  cursor: pointer;
  font-size: 1rem;
  line-height: 1;
  transition: background 180ms ease;
}

.remove-save:hover {
  background: var(--coral);
}

.saved-card-info {
  padding: 17px 18px 20px;
}

.saved-card-info p {
  margin: 0 0 4px;
  color: var(--muted);
  font-size: 0.62rem;
  font-weight: 700;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.saved-card-info h3 {
  margin: 0;
  font-family: var(--display);
  font-size: 1.5rem;
  font-weight: 600;
  letter-spacing: -0.06em;
  line-height: 1.03;
}

.saved-card-info .saved-meta {
  display: flex;
  gap: 7px;
  margin-top: 12px;
  color: var(--muted);
  font-size: 0.68rem;
}

.saved-card-info .saved-meta span + span::before {
  margin-right: 7px;
  content: "·";
}

.saved-empty {
  grid-column: 1 / -1;
  display: grid;
  place-items: center;
  min-height: 365px;
  border: 1px dashed rgba(30, 43, 49, 0.2);
  border-radius: 18px;
  background: rgba(252, 250, 245, 0.42);
  text-align: center;
}

.saved-empty-inner {
  max-width: 320px;
  padding: 28px;
}

.saved-empty-inner h3 {
  margin-bottom: 9px;
  font-family: var(--display);
  font-size: 2rem;
  font-weight: 600;
  letter-spacing: -0.06em;
}

.saved-empty-inner p {
  margin-bottom: 23px;
  color: var(--muted);
  font-size: 0.78rem;
  line-height: 1.65;
}

.footer {
  display: flex;
  justify-content: space-between;
  padding: 0 0 27px;
  color: var(--muted);
  font-size: 0.63rem;
}

.footer-slash {
  padding: 0 4px;
  color: var(--coral);
}

.toast {
  position: fixed;
  z-index: 30;
  right: 24px;
  bottom: 24px;
  max-width: min(330px, calc(100vw - 48px));
  padding: 12px 16px;
  border: 1px solid rgba(255, 250, 242, 0.22);
  border-radius: 9px;
  color: #fffaf2;
  background: var(--blue-deep);
  box-shadow: 0 10px 25px rgba(24, 55, 70, 0.18);
  font-size: 0.72rem;
  opacity: 0;
  pointer-events: none;
  transform: translateY(8px);
  transition: opacity 180ms ease, transform 180ms ease;
}

.toast.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes view-in {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes swipe-left {
  to {
    opacity: 0;
    transform: translate(-125%, 16%) rotate(-24deg);
  }
}

@keyframes swipe-right {
  to {
    opacity: 0;
    transform: translate(125%, 16%) rotate(24deg);
  }
}

@media (max-width: 1100px) {
  .app-shell {
    padding: 0 4vw;
  }

  .discover-view {
    grid-template-columns: minmax(190px, 0.7fr) minmax(380px, 1fr) minmax(140px, 0.46fr);
    gap: 35px;
  }

  .side-note {
    max-width: 135px;
  }
}

@media (max-width: 820px) {
  .topbar {
    min-height: 82px;
  }

  .topnav {
    gap: 18px;
    margin-left: 0;
  }

  .profile-trigger {
    font-size: 0;
  }

  .profile-trigger svg {
    display: none;
  }

  .discover-view {
    grid-template-columns: 1fr;
    gap: 30px;
    min-height: auto;
    padding-top: 42px;
  }

  .intro-column {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 28px;
    align-items: end;
  }

  .intro-column .eyebrow,
  .intro-column h1,
  .intro-column .intro-copy {
    grid-column: 1 / -1;
  }

  .intro-copy {
    max-width: 500px;
    margin-bottom: 0;
  }

  .micro-legend {
    display: flex;
    gap: 16px;
    align-items: center;
    padding-bottom: 2px;
  }

  .side-column {
    display: none;
  }

  .swipe-column {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
  }

  .profile-panel {
    grid-template-columns: 1fr;
  }

  .profile-art {
    min-height: 300px;
  }

  .saved-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 540px) {
  .app-shell {
    padding: 0 20px;
  }

  .wordmark-copy {
    font-size: 0.85rem;
  }

  .topnav {
    gap: 13px;
  }

  .nav-tab {
    font-size: 0.69rem;
  }

  .nav-count {
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    font-size: 0.6rem;
  }

  .profile-orbit {
    width: 24px;
    height: 24px;
  }

  .discover-view {
    padding-top: 35px;
  }

  h1 {
    max-width: 330px;
    font-size: 3.2rem;
  }

  .intro-copy {
    font-size: 0.82rem;
  }

  .intro-column {
    display: block;
  }

  .micro-legend {
    margin-top: 20px;
  }

  .progress-row {
    font-size: 0.59rem;
  }

  .card-stack {
    width: 100%;
    max-width: 390px;
  }

  .action-row {
    margin-top: 21px;
  }

  .section-heading {
    align-items: start;
    flex-direction: column;
    padding-top: 43px;
  }

  .section-heading h2 {
    font-size: 3rem;
  }

  .profile-art {
    min-height: 260px;
  }

  .profile-summary {
    padding: 34px 26px 38px;
  }

  .profile-summary h3 {
    font-size: 2.65rem;
  }

  .profile-footnote {
    margin-top: 31px;
  }

  .saved-grid {
    grid-template-columns: 1fr;
  }

  .saved-card {
    min-height: 350px;
  }

  .saved-card-art {
    height: 250px;
  }

  .footer {
    gap: 14px;
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
