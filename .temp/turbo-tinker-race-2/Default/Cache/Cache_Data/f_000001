<body>
  <div class="app-shell">
    <header class="topbar">
      <a class="brand" href="#" id="brandHome" aria-label="Turbo Tinker home">
        <span class="brand-mark">TT</span>
        <span><span class="brand-name">Turbo Tinker</span><span class="brand-sub">build tiny / go huge</span></span>
      </a>
      <div class="top-actions">
        <nav class="main-nav" aria-label="Game navigation">
          <button class="nav-button active" data-view="garage">Garage</button>
          <button class="nav-button" data-view="race">Race desk</button>
        </nav>
        <span class="status-chip" id="rendererBadge">checking renderer</span>
        <span class="status-chip best" id="bestBadge">no records yet</span>
      </div>
    </header>

    <main class="page-main">
      <section class="view" id="garageView">
        <div class="hero">
          <div class="hero-copy">
            <div class="eyebrow">build / tune / race</div>
            <h1>Make a kart that goes <em>zoom.</em></h1>
            <p>Mix the parts, find the sweet spot, then throw your tiny rocket around five very silly tracks.</p>
            <div class="hero-actions">
              <button class="primary-button" id="heroRaceButton">Take it to the grid <span aria-hidden="true">-></span></button>
              <span class="button-note">WASD / arrows + Shift to drift</span>
            </div>
          </div>
          <div class="hero-art" aria-label="Cartoon red kart illustration" role="img">
            <div class="hero-art-card">
              <div class="art-label"><span>pit pass 001</span><span>ready!</span></div>
              <div class="hero-kart">
                <div class="hero-kart-shadow"></div>
                <div class="hero-kart-flame"></div>
                <div class="hero-kart-body"></div>
                <div class="hero-kart-window"></div>
                <div class="hero-kart-nose"></div>
                <div class="hero-kart-eye"></div>
                <div class="hero-kart-wheel left"></div>
                <div class="hero-kart-wheel right"></div>
              </div>
              <div class="art-number">01</div>
            </div>
          </div>
        </div>

        <div class="section-heading" id="garageHeading">
          <div><div class="section-kicker">01 / your build</div><h2>Put the fun in function.</h2><p>Each part shifts how your kart feels. Chase speed, grip or ridiculous drifts.</p></div>
          <span class="tiny-label">click a part to swap it</span>
        </div>

        <div class="garage-layout">
          <aside class="panel panel-pad">
            <div class="build-preview">
              <div class="mini-kart" aria-hidden="true"><div class="flag"></div><div class="body"></div><div class="glass"></div><div class="hood"></div><div class="wheel one"></div><div class="wheel two"></div></div>
            </div>
            <div class="panel-title"><h3>Current kart</h3><span class="tiny-label" id="buildCode">TT-01</span></div>
            <ul class="build-list" id="buildList"></ul>
          </aside>

          <section class="part-groups" id="partGroups" aria-label="Kart parts"></section>

          <aside class="panel panel-pad tune-card">
            <div class="panel-title"><h3>Performance</h3><span class="tiny-label">live readout</span></div>
            <div class="score-block"><div><div class="score-number" id="speedScore">--</div><div class="score-unit">speed score</div></div><div class="synergy-pill"><strong id="synergyScore">0</strong>synergy</div></div>
            <dl class="stat-list" id="statList"></dl>
            <p class="tune-tip" id="tuneTip">Build a matched set for a little extra sparkle.</p>
          </aside>
        </div>

        <section class="track-section" id="trackSection">
          <div class="section-heading"><div><div class="section-kicker">02 / choose your chaos</div><h2>Pick a track.</h2><p>Three laps. Zero boring corners.</p></div><span class="tiny-label" id="selectedTrackLabel">Sunbeam Circuit selected</span></div>
          <div class="track-picker" id="trackPicker"></div>
        </section>

        <p class="footer-note">Turbo Tinker runs locally in your browser. WebGPU paints the sky when your browser says yes; Canvas2D keeps the race playable everywhere.</p>
      </section>

      <section class="view" id="raceView" hidden>
        <div class="race-toolbar">
          <div><div class="section-kicker">race desk / live</div><h1 id="raceTitle">Sunbeam <span>Circuit</span></h1></div>
          <div class="race-meta"><div class="race-meta-chip">build <strong id="raceBuildCode">TT-01</strong></div><button class="small-button" id="leaveRaceButton">Back to garage</button></div>
        </div>

        <div class="race-layout">
          <div class="race-stage" id="raceStage">
            <canvas id="atmosphereCanvas" aria-hidden="true"></canvas>
            <canvas id="gameCanvas" aria-label="Kart race view"></canvas>
            <div class="race-vignette"></div>
            <div class="stage-label" id="stageLabel">SUNBEAM CIRCUIT / 3 LAPS</div>
            <div class="countdown" id="countdown" hidden>3</div>
            <div class="race-toast" id="raceToast" aria-live="polite"></div>
            <div class="finish-overlay" id="finishOverlay" hidden>
              <div class="finish-card">
                <div class="finish-sticker">CHECKERED FLAG</div>
                <h2 id="finishTitle">Nice driving!</h2>
                <p id="finishCopy">You and your kart made it around.</p>
                <div class="finish-results">
                  <div class="finish-result"><strong id="finishPlace">1st</strong><small>place</small></div>
                  <div class="finish-result"><strong id="finishTime">00:00</strong><small>time</small></div>
                  <div class="finish-result"><strong id="finishSpeed">--</strong><small>speed score</small></div>
                </div>
                <div class="finish-actions"><button class="secondary-button" id="replayButton">Race again</button><button class="small-button" id="finishGarageButton">Garage</button></div>
              </div>
            </div>
          </div>

          <aside class="race-side">
            <section class="hud-card">
              <h2>Lap time</h2>
              <div class="lap-readout"><div class="lap-number"><span id="lapNumber">1</span><small> / 3</small></div><div class="race-clock" id="raceClock">00:00.0</div></div>
              <div class="progress-track"><span id="raceProgress"></span></div>
            </section>
            <section class="hud-card">
              <h2>Standings</h2>
              <ol class="standing-list" id="standingList"></ol>
            </section>
            <section class="hud-card minimap-card">
              <h2>Map</h2>
              <div class="minimap-wrap"><canvas id="minimap" width="240" height="145" aria-label="Race minimap"></canvas></div>
            </section>
            <section class="hud-card control-card">
              <h2>Controls</h2>
              <div class="control-row"><span>Drive</span><span><kbd>W</kbd> <kbd>A</kbd> <kbd>S</kbd> <kbd>D</kbd></span></div>
              <div class="control-row"><span>Drift</span><kbd>SHIFT</kbd></div>
              <div class="control-row"><span>Boost</span><kbd>SPACE</kbd></div>
            </section>
          </aside>
        </div>

        <div class="race-footer"><span id="raceHint">Hold Shift while turning. Let go to bottle the boost.</span><span>R to restart race</span></div>
        <div class="touch-controls" aria-label="Touch controls">
          <button class="touch-button" data-touch="left" aria-label="Steer left">LEFT</button>
          <button class="touch-button accent" data-touch="throttle" aria-label="Accelerate">GO!</button>
          <button class="touch-button" data-touch="right" aria-label="Steer right">RIGHT</button>
          <button class="touch-button" data-touch="brake" aria-label="Brake">BRAKE</button>
          <button class="touch-button drift" data-touch="drift" aria-label="Drift">DRIFT</button>
          <button class="touch-button accent" data-touch="boost" aria-label="Boost">BOOST</button>
        </div>
      </section>
    </main>
  </div>

  <script type="module">
    import {
      DEFAULT_BUILD,
      PART_CATALOG,
      TRACKS,
      clamp,
      createKartState,
      getBuildStats,
      nearestTrackProgress,
      pointAtProgress,
      releaseDrift,
      stepKart,
      tangentAtProgress,
      unwrapProgress,
    } from './game-core.mjs';

    const $ = (selector) => document.querySelector(selector);
    const $$ = (selector) => [...document.querySelectorAll(selector)];
    const STORAGE_KEY = 'turbo-tinker-state-v1';
    const TAU = Math.PI * 2;

    const game = {
      view: 'garage',
      build: { ...DEFAULT_BUILD },
      selectedTrack: TRACKS[0].id,
      bestTimes: {},
      race: null,
      animationId: 0,
      renderer: { ready: false, context: null, device: null, pipeline: null, bindGroup: null, uniformBuffer: null, format: null },
      input: { keys: new Set(), touch: {} },
      canvas: { width: 0, height: 0, dpr: 1 },
      toastTimer: 0,
    };

    const STAT_LABELS = { topSpeed: 'Top speed', acceleration: 'Launch', handling: 'Handling', grip: 'Grip', drift: 'Drift', boost: 'Boost tank' };
    const PART_LABELS = { chassis: 'Chassis', engine: 'Engine', tires: 'Tires', spoiler: 'Spoiler' };
    const RACER_NAMES = ['You', 'Pip', 'Momo', 'Ziggy'];
    const RACER_COLORS = ['#ff6b5e', '#62d2e8', '#9bdc69', '#b78cff'];

    function readSavedState() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        if (saved.build) game.build = { ...DEFAULT_BUILD, ...saved.build };
        if (saved.selectedTrack && TRACKS.some((track) => track.id === saved.selectedTrack)) game.selectedTrack = saved.selectedTrack;
        if (saved.bestTimes) game.bestTimes = saved.bestTimes;
      } catch (error) {
        console.warn('Turbo Tinker save could not be read.', error);
      }
    }

    function saveState() {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ build: game.build, selectedTrack: game.selectedTrack, bestTimes: game.bestTimes }));
    }

    function currentTrack() { return TRACKS.find((track) => track.id === game.selectedTrack) || TRACKS[0]; }

    function selectedStats() { return getBuildStats(game.build); }

    function formatTime(seconds, decimals = 1) {
      const safe = Math.max(0, seconds || 0);
      const minutes = Math.floor(safe / 60).toString().padStart(2, '0');
      const rest = (safe % 60).toFixed(decimals).padStart(decimals === 0 ? 2 : 4, '0');
      return `${minutes}:${rest}`;
    }

    function ordinal(value) {
      if (value === 1) return '1st';
      if (value === 2) return '2nd';
      if (value === 3) return '3rd';
      return `${value}th`;
    }

    function renderGarage() {
      const stats = selectedStats();
      const buildList = $('#buildList');
      buildList.innerHTML = Object.entries(PART_CATALOG).map(([slot, parts]) => {
        const part = parts.find((option) => option.id === game.build[slot]) || parts[0];
        return `<li><span><span class="build-part-slot">${PART_LABELS[slot]}</span><span class="build-part-name">${part.name}</span></span><span class="build-part-code">${part.icon}</span></li>`;
      }).join('');

      $('#buildCode').textContent = buildCode();
      $('#speedScore').textContent = Math.round(stats.topSpeed * 100);
      $('#synergyScore').textContent = `${stats.synergy}/3`;
      $('#tuneTip').textContent = stats.synergy >= 3
        ? 'Full synergy! Your build is singing. Expect a punchier launch and a longer boost.'
        : stats.synergy === 2
          ? 'Two parts are vibing together. Try matching the remaining theme for a full combo.'
          : 'Build a matched set for a little extra sparkle.';

      $('#statList').innerHTML = Object.entries(STAT_LABELS).map(([key, label]) => `<div class="stat-row"><dt>${label}</dt><dd class="stat-bar"><span style="width:${Math.round(stats[key] * 100)}%"></span></dd><dd>${Math.round(stats[key] * 100)}</dd></div>`).join('');
      renderPartGroups();
      renderTracks();
      $('#raceBuildCode').textContent = buildCode();
      const track = currentTrack();
      $('#selectedTrackLabel').textContent = `${track.name} selected`;
      $('#bestBadge').textContent = game.bestTimes[track.id] ? `best ${formatTime(game.bestTimes[track.id], 1)}` : 'no records yet';
    }

    function renderPartGroups() {
      $('#partGroups').innerHTML = Object.entries(PART_CATALOG).map(([slot, parts]) => `<section class="panel part-group"><div class="part-group-heading"><h3>${PART_LABELS[slot]}</h3><span class="tiny-label">choose one</span></div><div class="part-grid">${parts.map((part) => `<button class="part-card${game.build[slot] === part.id ? ' selected' : ''}" data-part-slot="${slot}" data-part-id="${part.id}"><span class="part-icon">${part.icon}</span><strong>${part.name}</strong><small>${part.note}</small></button>`).join('')}</div></section>`).join('');
    }

    function renderTracks() {
      $('#trackPicker').innerHTML = TRACKS.map((track) => `<button class="track-card${track.id === game.selectedTrack ? ' selected' : ''}" data-track-id="${track.id}" style="--track-a:${track.sky[0]};--track-b:${track.sky[1]}"><span class="track-color"></span><span class="track-content"><span class="track-badge">${track.badge} / ${track.laps} LAPS</span><strong>${track.name}</strong><small>${track.subtitle}</small></span></button>`).join('');
    }

    function buildCode() {
      const values = Object.values(game.build).join('').toUpperCase();
      return `TT-${values.slice(0, 3)}`;
    }

    function switchView(view) {
      if (view === 'race' && !game.race) startRace();
      game.view = view;
      $('#garageView').hidden = view !== 'garage';
      $('#raceView').hidden = view !== 'race';
      $$('.nav-button').forEach((button) => button.classList.toggle('active', button.dataset.view === view));
      if (view === 'race') window.scrollTo({ top: 0, behavior: 'smooth' });
      else stopRace();
    }

    function makeRace() {
      const track = currentTrack();
      const startPoint = pointAtProgress(track, 0);
      const startAngle = tangentAtProgress(track, 0);
      const stats = selectedStats();
      const racers = [0, 1, 2, 3].map((index) => {
        const progress = index === 0 ? 0 : -0.02 - index * 0.014;
        const point = pointAtProgress(track, progress);
        const racer = {
          id: index === 0 ? 'player' : `ai-${index}`,
          name: RACER_NAMES[index],
          color: RACER_COLORS[index],
          isPlayer: index === 0,
          progress,
          totalProgress: progress,
          lastRawProgress: ((progress % 1) + 1) % 1,
          rate: index === 0 ? 0 : 0.054 + track.difficulty * 0.006 - index * 0.002,
          lane: index === 0 ? 0 : (index % 2 === 0 ? 23 : -23),
          state: createKartState(point.x + (index % 2 ? -24 : 24), point.y, startAngle),
          trail: [],
        };
        if (index === 0) racer.state = createKartState(startPoint.x, startPoint.y, startAngle);
        return racer;
      });
      return {
        track,
        stats,
        racers,
        phase: 'countdown',
        countdown: 3.2,
        elapsed: 0,
        startedAt: 0,
        lastFrame: 0,
        playerProgress: 0,
        camera: { x: startPoint.x, y: startPoint.y },
        skids: [],
        particles: [],
        finishPlace: 1,
      };
    }

    function startRace() {
      stopRace();
      game.race = makeRace();
      switchView('race');
      renderRaceChrome();
      $('#finishOverlay').hidden = true;
      $('#countdown').hidden = false;
      $('#countdown').textContent = '3';
      game.race.lastFrame = performance.now();
      game.animationId = requestAnimationFrame(raceLoop);
    }

    function stopRace() {
      if (game.animationId) cancelAnimationFrame(game.animationId);
      game.animationId = 0;
      if (game.view !== 'race') game.race = null;
    }

    function restartRace() { startRace(); }

    function raceLoop(timestamp) {
      if (!game.race || game.view !== 'race') return;
      const race = game.race;
      const dt = Math.min(0.035, Math.max(0, (timestamp - race.lastFrame) / 1000));
      race.lastFrame = timestamp;
      updateRace(race, dt, timestamp);
      renderRace(race, timestamp / 1000);
      game.animationId = requestAnimationFrame(raceLoop);
    }

    function updateRace(race, dt, timestamp) {
      if (race.phase === 'countdown') {
        race.countdown -= dt;
        const number = Math.ceil(Math.max(0, race.countdown));
        $('#countdown').textContent = number > 0 ? number : 'GO!';
        if (race.countdown <= 0) {
          race.phase = 'racing';
          race.startedAt = timestamp;
          $('#countdown').hidden = true;
          showToast('Find the clean line and let the kart dance.');
        }
        return;
      }
      if (race.phase !== 'racing') return;

      race.elapsed += dt;
      const player = race.racers[0];
      const input = getInput();
      const before = player.state;
      player.state = stepKart(player.state, input, race.stats, dt);
      if (before.wasDrifting && !player.state.wasDrifting && before.driftCharge > 0.28) player.state = releaseDrift(player.state, race.stats);

      const nearest = nearestTrackProgress(race.track, player.state.position);
      player.lastRawProgress = nearest.progress;
      const nextProgress = unwrapProgress(player.totalProgress, nearest.progress);
      player.totalProgress = Math.max(player.totalProgress - 0.001, nextProgress);
      race.playerProgress = player.totalProgress;
      if (nearest.distance > 128) player.state.speed = Math.max(0, player.state.speed - dt * (0.8 + nearest.distance / 180));
      if (nearest.distance > 320) {
        const safePoint = pointAtProgress(race.track, player.totalProgress % 1);
        player.state.position = { ...safePoint };
        player.state.speed = 0;
        showToast('A little off-track! Back on the candy-colored road.');
      }

      if (player.state.wasDrifting && player.state.skidTime > 0.03) {
        race.skids.push({ x: player.state.position.x, y: player.state.position.y, angle: player.state.angle, life: 1 });
      }
      if (input.boost && player.state.boostTime > 0) spawnBoostParticles(race, player);
      updateAI(race, dt);
      updateParticles(race, dt);
      race.racers.forEach((racer) => {
        racer.trail.push({ x: racer.state.position.x, y: racer.state.position.y, life: 1 });
        if (racer.trail.length > 10) racer.trail.shift();
      });
      race.skids = race.skids.filter((skid) => { skid.life -= dt * 0.4; return skid.life > 0; });
      updateStandings(race);

      if (player.totalProgress >= race.track.laps) finishRace(race);
    }

    function updateAI(race, dt) {
      race.racers.slice(1).forEach((racer) => {
        if (racer.totalProgress >= race.track.laps) return;
        racer.totalProgress += racer.rate * dt;
        racer.progress = racer.totalProgress;
        const center = pointAtProgress(race.track, racer.totalProgress);
        const tangent = tangentAtProgress(race.track, racer.totalProgress);
        const side = { x: Math.cos(tangent + Math.PI / 2) * racer.lane, y: Math.sin(tangent + Math.PI / 2) * racer.lane };
        racer.state.position.x += ((center.x + side.x) - racer.state.position.x) * Math.min(1, dt * 8);
        racer.state.position.y += ((center.y + side.y) - racer.state.position.y) * Math.min(1, dt * 8);
        racer.state.angle = tangent;
        racer.state.speed = racer.rate * race.track.totalLength / 260;
      });
    }

    function updateStandings(race) {
      race.racers.slice().sort((a, b) => b.totalProgress - a.totalProgress).forEach((racer, index) => { racer.place = index + 1; });
      race.finishPlace = race.racers[0].place || 1;
    }

    function finishRace(race) {
      race.phase = 'finished';
      race.elapsed = Math.max(race.elapsed, 0.1);
      updateStandings(race);
      const priorBest = game.bestTimes[race.track.id];
      if (!priorBest || race.elapsed < priorBest) {
        game.bestTimes[race.track.id] = race.elapsed;
        saveState();
      }
      $('#countdown').hidden = true;
      $('#finishTitle').textContent = race.finishPlace === 1 ? 'You little rocket!' : 'Race complete!';
      $('#finishCopy').textContent = race.finishPlace === 1 ? 'That build had the good stuff. The podium is yours.' : `A ${ordinal(race.finishPlace)}-place finish on ${race.track.name}. Tune it and go again.`;
      $('#finishPlace').textContent = ordinal(race.finishPlace);
      $('#finishTime').textContent = formatTime(race.elapsed, 1);
      $('#finishSpeed').textContent = Math.round(race.stats.topSpeed * 100);
      $('#finishOverlay').hidden = false;
      renderGarage();
    }

    function spawnBoostParticles(race, racer) {
      const back = { x: racer.state.position.x - Math.cos(racer.state.angle) * 18, y: racer.state.position.y - Math.sin(racer.state.angle) * 18 };
      race.particles.push({ x: back.x, y: back.y, life: 1, color: Math.random() > 0.5 ? '#ffdc65' : '#ff8e70', size: 7 + Math.random() * 8, vx: -Math.cos(racer.state.angle) * 30, vy: -Math.sin(racer.state.angle) * 30 });
      if (race.particles.length > 80) race.particles.shift();
    }

    function updateParticles(race, dt) {
      race.particles = race.particles.filter((particle) => {
        particle.life -= dt * 2.6;
        particle.x += particle.vx * dt;
        particle.y += particle.vy * dt;
        particle.size *= 0.985;
        return particle.life > 0;
      });
    }

    function getInput() {
      const keys = game.input.keys;
      const touch = game.input.touch;
      const left = keys.has('arrowleft') || keys.has('a') || touch.left;
      const right = keys.has('arrowright') || keys.has('d') || touch.right;
      return {
        throttle: keys.has('arrowup') || keys.has('w') || touch.throttle ? 1 : 0,
        brake: keys.has('arrowdown') || keys.has('s') || touch.brake ? 1 : 0,
        steer: left && !right ? -1 : right && !left ? 1 : 0,
        drift: keys.has('shift') || touch.drift,
        boost: keys.has(' ') || touch.boost,
      };
    }

    function renderRaceChrome() {
      const race = game.race;
      const track = race.track;
      const titleParts = track.name.split(' ');
      $('#raceTitle').innerHTML = `${titleParts.slice(0, -1).join(' ')} <span>${titleParts.at(-1)}</span>`;
      $('#stageLabel').textContent = `${track.name.toUpperCase()} / ${track.laps} LAPS`;
      $('#raceBuildCode').textContent = buildCode();
      $('#lapNumber').textContent = '1';
      $('#raceClock').textContent = '00:00.0';
      $('#raceProgress').style.width = '0%';
      renderStandings(race);
    }

    function renderRace(race, time) {
      resizeCanvases();
      renderAtmosphere(time, race.track);
      renderWorld(race, time);
      renderHud(race);
      drawMinimap(race);
    }

    function renderHud(race) {
      const player = race.racers[0];
      const completedLaps = Math.floor(Math.max(0, player.totalProgress));
      $('#lapNumber').textContent = Math.min(race.track.laps, completedLaps + 1);
      $('#raceClock').textContent = formatTime(race.elapsed, 1);
      $('#raceProgress').style.width = `${Math.round(clamp(player.totalProgress / race.track.laps) * 100)}%`;
      renderStandings(race);
    }

    function renderStandings(race) {
      $('#standingList').innerHTML = race.racers.slice().sort((a, b) => (a.place || 99) - (b.place || 99)).map((racer) => `<li class="${racer.isPlayer ? 'player' : ''}"><span class="standing-place">${racer.place || '-'}</span><span style="display:flex;align-items:center;gap:7px"><span class="standing-dot" style="background:${racer.color}"></span>${racer.name}</span><span class="standing-time">${racer.isPlayer ? formatTime(race.elapsed, 1) : `${Math.round(clamp(racer.totalProgress / race.track.laps) * 100)}%`}</span></li>`).join('');
    }

    function resizeCanvases() {
      const stage = $('#raceStage');
      const rect = stage.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      if (game.canvas.width === rect.width && game.canvas.height === rect.height && game.canvas.dpr === dpr) return;
      game.canvas = { width: rect.width, height: rect.height, dpr };
      ['gameCanvas', 'atmosphereCanvas'].forEach((id) => {
        const canvas = $(`#${id}`);
        canvas.width = Math.max(1, Math.floor(rect.width * dpr));
        canvas.height = Math.max(1, Math.floor(rect.height * dpr));
      });
      if (game.renderer.ready) configureGpuCanvas();
    }

    function renderAtmosphere(time, track) {
      if (!game.renderer.ready) return;
      const { device, context, pipeline, bindGroup, uniformBuffer } = game.renderer;
      const colors = [...hexToRgb(track.sky[0]), ...hexToRgb(track.sky[1])];
      device.queue.writeBuffer(uniformBuffer, 0, new Float32Array([time, 0, 0, 0, ...colors]));
      const encoder = device.createCommandEncoder();
      const pass = encoder.beginRenderPass({ colorAttachments: [{ view: context.getCurrentTexture().createView(), clearValue: { r: colors[0], g: colors[1], b: colors[2], a: 1 }, loadOp: 'clear', storeOp: 'store' }] });
      pass.setPipeline(pipeline);
      pass.setBindGroup(0, bindGroup);
      pass.draw(3);
      pass.end();
      device.queue.submit([encoder.finish()]);
    }

    function renderWorld(race, time) {
      const canvas = $('#gameCanvas');
      const ctx = canvas.getContext('2d');
      const { width, height, dpr } = game.canvas;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);
      if (!game.renderer.ready) {
        const gradient = ctx.createLinearGradient(0, 0, 0, height);
        gradient.addColorStop(0, race.track.sky[0]);
        gradient.addColorStop(1, race.track.sky[1]);
        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, width, height);
      }

      const player = race.racers[0];
      race.camera.x += (player.state.position.x - race.camera.x) * 0.055;
      race.camera.y += (player.state.position.y - race.camera.y) * 0.055;
      const scale = Math.min(width / 1140, height / 700) * 0.94;
      const offsetX = width / 2 - race.camera.x * scale;
      const offsetY = height / 2 - race.camera.y * scale;

      ctx.save();
      ctx.translate(offsetX, offsetY);
      ctx.scale(scale, scale);
      drawWorldBackdrop(ctx, race.track, time);
      drawTrack(ctx, race.track);
      drawStartLine(ctx, race.track);
      race.skids.forEach((skid) => drawSkid(ctx, skid));
      race.particles.forEach((particle) => drawParticle(ctx, particle));
      race.racers.slice().sort((a, b) => a.state.position.y - b.state.position.y).forEach((racer) => drawKart(ctx, racer, time));
      ctx.restore();
    }

    function drawWorldBackdrop(ctx, track, time) {
      ctx.save();
      ctx.globalAlpha = 0.33;
      ctx.fillStyle = track.accent;
      for (let index = 0; index < 13; index += 1) {
        const x = ((index * 251 + track.difficulty * 93) % 1450) - 60;
        const y = ((index * 157 + track.difficulty * 71) % 850) - 50;
        ctx.beginPath();
        ctx.ellipse(x, y, 90 + (index % 3) * 25, 42 + (index % 2) * 18, 0, 0, TAU);
        ctx.fill();
      }
      ctx.globalAlpha = 0.45;
      for (let index = 0; index < 22; index += 1) {
        const x = ((index * 181 + 50) % 1430);
        const y = ((index * 223 + 90) % 820);
        drawTree(ctx, x, y, 0.7 + (index % 3) * 0.15, track, index % 2 === 0);
      }
      ctx.globalAlpha = 0.52;
      ctx.fillStyle = '#fff';
      for (let index = 0; index < 5; index += 1) {
        const x = ((index * 309 + time * 4) % 1600) - 110;
        const y = 70 + (index % 2) * 90;
        drawCloud(ctx, x, y, 0.7 + (index % 2) * 0.2);
      }
      ctx.restore();
    }

    function drawTrack(ctx, track) {
      const path = () => { ctx.beginPath(); track.path.forEach((point, index) => index ? ctx.lineTo(point.x, point.y) : ctx.moveTo(point.x, point.y)); ctx.closePath(); };
      ctx.save();
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      path(); ctx.lineWidth = 226; ctx.strokeStyle = 'rgba(32,41,67,0.18)'; ctx.stroke();
      path(); ctx.lineWidth = 210; ctx.strokeStyle = track.grass; ctx.stroke();
      path(); ctx.lineWidth = 190; ctx.setLineDash([28, 28]); ctx.strokeStyle = track.curb; ctx.stroke();
      ctx.setLineDash([]); path(); ctx.lineWidth = 166; ctx.strokeStyle = track.road; ctx.stroke();
      path(); ctx.lineWidth = 145; ctx.strokeStyle = 'rgba(255,255,255,0.08)'; ctx.stroke();
      path(); ctx.lineWidth = 3; ctx.setLineDash([24, 26]); ctx.strokeStyle = 'rgba(255,255,255,0.23)'; ctx.stroke();
      ctx.restore();
    }

    function drawStartLine(ctx, track) {
      const point = pointAtProgress(track, 0);
      const angle = tangentAtProgress(track, 0) + Math.PI / 2;
      ctx.save();
      ctx.translate(point.x, point.y);
      ctx.rotate(angle);
      const size = 15;
      for (let x = -5; x <= 5; x += 1) for (let y = -1; y <= 1; y += 1) { ctx.fillStyle = (x + y) % 2 === 0 ? '#fff' : '#202943'; ctx.fillRect(x * size, y * size, size, size); }
      ctx.restore();
    }

    function drawKart(ctx, racer, time) {
      const { state } = racer;
      ctx.save();
      ctx.translate(state.position.x, state.position.y);
      ctx.rotate(state.angle);
      ctx.globalAlpha = racer.isPlayer ? 1 : 0.94;
      ctx.fillStyle = 'rgba(32,41,67,0.28)';
      ctx.beginPath(); ctx.ellipse(0, 15, 34, 12, 0, 0, TAU); ctx.fill();
      if (racer.trail.length > 1) {
        ctx.save(); ctx.globalAlpha = 0.12; ctx.strokeStyle = racer.color; ctx.lineWidth = 10; ctx.lineCap = 'round'; ctx.beginPath(); racer.trail.forEach((point, index) => index ? ctx.lineTo(point.x - state.position.x, point.y - state.position.y) : ctx.moveTo(point.x - state.position.x, point.y - state.position.y)); ctx.stroke(); ctx.restore();
      }
      if (state.boostTime > 0) {
        ctx.fillStyle = '#ffdc65'; ctx.strokeStyle = '#202943'; ctx.lineWidth = 3;
        ctx.beginPath(); ctx.moveTo(-39, 0); ctx.lineTo(-58 - Math.sin(time * 17) * 5, 10); ctx.lineTo(-48, 0); ctx.lineTo(-58 - Math.cos(time * 13) * 4, -12); ctx.closePath(); ctx.fill(); ctx.stroke();
      }
      ctx.fillStyle = '#33405c';
      ctx.beginPath(); ctx.roundRect(-25, -17, 15, 38, 8); ctx.roundRect(12, -17, 15, 38, 8); ctx.fill();
      ctx.fillStyle = racer.color; ctx.strokeStyle = '#202943'; ctx.lineWidth = 4;
      ctx.beginPath(); ctx.roundRect(-28, -18, 57, 37, 17); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#ffdc65'; ctx.strokeStyle = '#202943';
      ctx.beginPath(); ctx.roundRect(0, -17, 29, 30, 12); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#73d7e8'; ctx.strokeStyle = '#202943';
      ctx.beginPath(); ctx.ellipse(-4, -8, 17, 12, -0.18, 0, TAU); ctx.fill(); ctx.stroke();
      ctx.fillStyle = '#202943'; ctx.beginPath(); ctx.arc(10, -8, 3, 0, TAU); ctx.fill();
      ctx.fillStyle = '#fff'; ctx.beginPath(); ctx.arc(11, -9, 1, 0, TAU); ctx.fill();
      ctx.fillStyle = racer.isPlayer ? '#fff' : 'rgba(255,255,255,0.75)'; ctx.font = '900 8px Trebuchet MS'; ctx.textAlign = 'center'; ctx.fillText(racer.isPlayer ? 'YOU' : racer.name.toUpperCase(), 0, 31);
      if (state.wasDrifting) {
        ctx.fillStyle = '#ffdc65'; ctx.strokeStyle = '#202943'; ctx.lineWidth = 2;
        [-1, 1].forEach((side) => { ctx.beginPath(); ctx.arc(-23, side * 19, 4 + Math.sin(time * 14 + side) * 2, 0, TAU); ctx.fill(); ctx.stroke(); });
      }
      ctx.restore();
    }

    function drawSkid(ctx, skid) {
      ctx.save(); ctx.globalAlpha = skid.life * 0.24; ctx.translate(skid.x, skid.y); ctx.rotate(skid.angle); ctx.strokeStyle = '#202943'; ctx.lineWidth = 5; ctx.lineCap = 'round'; ctx.beginPath(); ctx.moveTo(-17, -15); ctx.lineTo(14, -15); ctx.moveTo(-17, 15); ctx.lineTo(14, 15); ctx.stroke(); ctx.restore();
    }

    function drawParticle(ctx, particle) {
      ctx.save(); ctx.globalAlpha = particle.life; ctx.fillStyle = particle.color; ctx.strokeStyle = '#202943'; ctx.lineWidth = 2; ctx.beginPath(); ctx.arc(particle.x, particle.y, particle.size * particle.life, 0, TAU); ctx.fill(); ctx.stroke(); ctx.restore();
    }

    function drawTree(ctx, x, y, scale, track, round) {
      ctx.save(); ctx.translate(x, y); ctx.scale(scale, scale); ctx.fillStyle = '#8f6a55'; ctx.fillRect(-5, 6, 10, 20); ctx.fillStyle = round ? track.accent : '#76c967'; ctx.beginPath(); ctx.arc(-9, 4, 15, 0, TAU); ctx.arc(8, 4, 16, 0, TAU); ctx.arc(0, -9, 18, 0, TAU); ctx.fill(); ctx.strokeStyle = 'rgba(32,41,67,0.18)'; ctx.lineWidth = 2; ctx.stroke(); ctx.restore();
    }

    function drawCloud(ctx, x, y, scale) { ctx.save(); ctx.translate(x, y); ctx.scale(scale, scale); ctx.beginPath(); ctx.arc(0, 0, 23, 0, TAU); ctx.arc(22, 4, 18, 0, TAU); ctx.arc(45, 0, 24, 0, TAU); ctx.fill(); ctx.restore(); }

    function drawMinimap(race) {
      const canvas = $('#minimap');
      const ctx = canvas.getContext('2d');
      const width = canvas.width; const height = canvas.height;
      ctx.clearRect(0, 0, width, height);
      const map = (point) => ({ x: 15 + point.x / 1400 * (width - 30), y: 15 + point.y / 900 * (height - 30) });
      const path = () => { ctx.beginPath(); race.track.path.forEach((point, index) => { const mapped = map(point); index ? ctx.lineTo(mapped.x, mapped.y) : ctx.moveTo(mapped.x, mapped.y); }); ctx.closePath(); };
      path(); ctx.lineCap = 'round'; ctx.lineJoin = 'round'; ctx.lineWidth = 27; ctx.strokeStyle = '#9aa878'; ctx.stroke(); path(); ctx.lineWidth = 20; ctx.strokeStyle = '#56657d'; ctx.stroke();
      race.racers.forEach((racer) => { const point = map(racer.state.position); ctx.fillStyle = racer.color; ctx.strokeStyle = '#202943'; ctx.lineWidth = racer.isPlayer ? 3 : 2; ctx.beginPath(); ctx.arc(point.x, point.y, racer.isPlayer ? 5 : 4, 0, TAU); ctx.fill(); ctx.stroke(); });
    }

    function showToast(message) {
      const toast = $('#raceToast');
      toast.textContent = message;
      toast.classList.add('show');
      clearTimeout(game.toastTimer);
      game.toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
    }

    function hexToRgb(hex) {
      const value = hex.replace('#', '');
      const integer = Number.parseInt(value, 16);
      return [(integer >> 16 & 255) / 255, (integer >> 8 & 255) / 255, (integer & 255) / 255];
    }

    async function setupWebGpu() {
      const badge = $('#rendererBadge');
      if (!navigator.gpu) {
        badge.textContent = 'canvas fallback'; badge.classList.add('fallback'); return;
      }
      try {
        const adapter = await navigator.gpu.requestAdapter();
        if (!adapter) throw new Error('No WebGPU adapter');
        const device = await adapter.requestDevice();
        const context = $('#atmosphereCanvas').getContext('webgpu');
        const shader = device.createShaderModule({ code: `
          struct Uniforms { time: f32, pad: vec3<f32>, top: vec4<f32>, bottom: vec4<f32> };
          @group(0) @binding(0) var<uniform> uniforms: Uniforms;
          struct Output { @builtin(position) position: vec4<f32>, @location(0) uv: vec2<f32> };
          @vertex fn vertex(@builtin(vertex_index) index: u32) -> Output {
            var positions = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));
            var output: Output;
            output.position = vec4<f32>(positions[index], 0.0, 1.0);
            output.uv = positions[index] * 0.5 + vec2<f32>(0.5);
            return output;
          }
          @fragment fn fragment(input: Output) -> @location(0) vec4<f32> {
            let wave = sin(input.uv.x * 7.0 + uniforms.time * 0.18) * 0.025;
            let sparkle = smoothstep(0.992, 1.0, sin(input.uv.x * 42.0 + uniforms.time * 0.6) * sin(input.uv.y * 31.0 - uniforms.time * 0.4));
            let color = mix(uniforms.bottom.rgb, uniforms.top.rgb, 1.0 - input.uv.y) + vec3<f32>(wave + sparkle * 0.08);
            return vec4<f32>(color, 1.0);
          }
        ` });
        const format = navigator.gpu.getPreferredCanvasFormat();
        game.renderer = { ready: true, context, device, pipeline: null, bindGroup: null, uniformBuffer: null, format };
        configureGpuCanvas();
        const uniformBuffer = device.createBuffer({ size: 48, usage: GPUBufferUsage.UNIFORM | GPUBufferUsage.COPY_DST });
        const pipeline = device.createRenderPipeline({ layout: 'auto', vertex: { module: shader, entryPoint: 'vertex' }, fragment: { module: shader, entryPoint: 'fragment', targets: [{ format }] }, primitive: { topology: 'triangle-list' } });
        const bindGroup = device.createBindGroup({ layout: pipeline.getBindGroupLayout(0), entries: [{ binding: 0, resource: { buffer: uniformBuffer } }] });
        game.renderer.uniformBuffer = uniformBuffer; game.renderer.pipeline = pipeline; game.renderer.bindGroup = bindGroup;
        badge.textContent = 'webgpu live'; badge.classList.add('live');
        device.lost.then(() => { game.renderer.ready = false; badge.textContent = 'canvas fallback'; badge.classList.remove('live'); badge.classList.add('fallback'); });
      } catch (error) {
        console.warn('WebGPU unavailable, using Canvas2D fallback.', error);
        game.renderer.ready = false;
        badge.textContent = 'canvas fallback'; badge.classList.add('fallback');
      }
    }

    function configureGpuCanvas() {
      if (!game.renderer.context) return;
      const { width, height, dpr } = game.canvas;
      const canvas = $('#atmosphereCanvas');
      canvas.width = Math.max(1, Math.floor(width * dpr));
      canvas.height = Math.max(1, Math.floor(height * dpr));
      game.renderer.context.configure({ device: game.renderer.device, format: game.renderer.format, alphaMode: 'opaque' });
    }

    function bindEvents() {
      document.addEventListener('click', (event) => {
        const viewButton = event.target.closest('[data-view]');
        if (viewButton) { switchView(viewButton.dataset.view); return; }
        const partButton = event.target.closest('[data-part-slot]');
        if (partButton) { game.build[partButton.dataset.partSlot] = partButton.dataset.partId; saveState(); renderGarage(); return; }
        const trackButton = event.target.closest('[data-track-id]');
        if (trackButton) { game.selectedTrack = trackButton.dataset.trackId; saveState(); renderGarage(); return; }
      });

      $('#heroRaceButton').addEventListener('click', () => { document.querySelector('#trackSection').scrollIntoView({ behavior: 'smooth', block: 'start' }); showToast('Pick a track, then hit Race desk.'); });
      $('#brandHome').addEventListener('click', (event) => { event.preventDefault(); switchView('garage'); });
      $('#leaveRaceButton').addEventListener('click', () => switchView('garage'));
      $('#finishGarageButton').addEventListener('click', () => switchView('garage'));
      $('#replayButton').addEventListener('click', restartRace);

      window.addEventListener('keydown', (event) => {
        const key = event.key.toLowerCase();
        if (['arrowup', 'arrowdown', 'arrowleft', 'arrowright', ' ', 'shift'].includes(key)) event.preventDefault();
        game.input.keys.add(key);
        if (key === 'r' && game.view === 'race') restartRace();
        if (key === 'escape' && game.view === 'race') switchView('garage');
      });
      window.addEventListener('keyup', (event) => game.input.keys.delete(event.key.toLowerCase()));
      $$('.touch-button').forEach((button) => {
        const setTouch = (value) => { game.input.touch[button.dataset.touch] = value; button.classList.toggle('pressed', value); };
        button.addEventListener('pointerdown', (event) => { event.preventDefault(); button.setPointerCapture(event.pointerId); setTouch(true); });
        button.addEventListener('pointerup', () => setTouch(false));
        button.addEventListener('pointercancel', () => setTouch(false));
        button.addEventListener('pointerleave', () => setTouch(false));
      });
      window.addEventListener('resize', () => { if (game.race) resizeCanvases(); });
    }

    readSavedState();
    renderGarage();
    bindEvents();
    setupWebGpu();
    if (location.hash === '#race') setTimeout(startRace, 120);
  </script>
</body>
</html>
