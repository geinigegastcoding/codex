<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fff8e9">
  <title>Turbo Tinker - cartoon kart racer</title>
  <style>
    :root {
      --ink: #202943;
      --muted: #67708b;
      --paper: #fff9ec;
      --paper-deep: #f7edda;
      --card: rgba(255, 255, 255, 0.88);
      --coral: #ff6b5e;
      --coral-dark: #d95153;
      --cyan: #44c9e8;
      --lime: #94d66d;
      --yellow: #ffdc65;
      --violet: #8e7af6;
      --line: rgba(32, 41, 67, 0.11);
      --shadow: 0 12px 0 rgba(32, 41, 67, 0.09);
      --soft-shadow: 0 24px 60px rgba(73, 65, 105, 0.12);
      color-scheme: light;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    body {
      min-width: 320px;
      margin: 0;
      overflow-x: hidden;
      color: var(--ink);
      background:
        radial-gradient(circle at 12% 6%, rgba(255, 220, 101, 0.45) 0 2px, transparent 3px),
        radial-gradient(circle at 88% 18%, rgba(68, 201, 232, 0.28) 0 3px, transparent 4px),
        var(--paper);
      background-size: 28px 28px, 38px 38px, auto;
      font-family: "Trebuchet MS", "Avenir Next", ui-rounded, sans-serif;
      line-height: 1.45;
    }

    button { font: inherit; }

    button:focus-visible, [tabindex]:focus-visible {
      outline: 4px solid var(--cyan);
      outline-offset: 3px;
    }

    .app-shell { overflow: hidden; }

    .topbar {
      position: sticky;
      z-index: 20;
      top: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      min-height: 76px;
      padding: 14px clamp(18px, 4vw, 64px);
      border-bottom: 1px solid rgba(32, 41, 67, 0.08);
      background: rgba(255, 249, 236, 0.88);
      backdrop-filter: blur(16px);
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      color: var(--ink);
      text-decoration: none;
    }

    .brand-mark {
      position: relative;
      display: grid;
      width: 42px;
      height: 42px;
      place-items: center;
      overflow: hidden;
      border: 3px solid var(--ink);
      border-radius: 14px 14px 14px 4px;
      color: var(--ink);
      background: var(--yellow);
      box-shadow: 4px 4px 0 var(--ink);
      font-weight: 900;
      transform: rotate(-5deg);
    }

    .brand-mark::after {
      position: absolute;
      right: 6px;
      bottom: 6px;
      width: 12px;
      height: 5px;
      border-radius: 50%;
      background: var(--coral);
      content: "";
      transform: rotate(-12deg);
    }

    .brand-name {
      display: block;
      font-size: 1.04rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      line-height: 1;
    }

    .brand-sub {
      display: block;
      margin-top: 4px;
      color: var(--muted);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.13em;
      text-transform: uppercase;
    }

    .top-actions { display: flex; align-items: center; gap: 10px; }

    .status-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 34px;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 999px;
      color: var(--muted);
      background: rgba(255, 255, 255, 0.75);
      font-size: 0.72rem;
      font-weight: 900;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .status-chip::before {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--yellow);
      box-shadow: 0 0 0 4px rgba(255, 220, 101, 0.2);
      content: "";
    }

    .status-chip.live::before { background: var(--lime); box-shadow: 0 0 0 4px rgba(148, 214, 109, 0.2); }
    .status-chip.fallback::before { background: var(--coral); box-shadow: 0 0 0 4px rgba(255, 107, 94, 0.2); }

    .main-nav { display: flex; gap: 4px; padding: 4px; border-radius: 999px; background: rgba(32, 41, 67, 0.06); }
    .nav-button {
      padding: 8px 13px;
      border: 0;
      border-radius: 999px;
      color: var(--muted);
      background: transparent;
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 900;
    }
    .nav-button.active { color: var(--ink); background: white; box-shadow: 0 3px 10px rgba(32, 41, 67, 0.08); }

    .page-main { width: min(1440px, 100%); margin: 0 auto; padding: clamp(24px, 4vw, 62px) clamp(18px, 4vw, 64px) 70px; }
    .view[hidden] { display: none !important; }

    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(280px, 0.75fr);
      gap: 34px;
      min-height: 360px;
      padding: clamp(28px, 5vw, 74px);
      overflow: hidden;
      border: 1px solid rgba(32, 41, 67, 0.09);
      border-radius: 34px;
      background:
        radial-gradient(circle at 78% 12%, rgba(255, 255, 255, 0.5) 0 3px, transparent 4px),
        radial-gradient(circle at 92% 64%, rgba(255, 255, 255, 0.36) 0 4px, transparent 5px),
        linear-gradient(120deg, #ffd66a 0%, #ffb98c 45%, #ff91bd 100%);
      box-shadow: var(--soft-shadow);
    }

    .hero::before, .hero::after { position: absolute; border-radius: 50%; content: ""; pointer-events: none; }
    .hero::before { top: -130px; right: 18%; width: 330px; height: 330px; border: 38px solid rgba(255, 255, 255, 0.18); }
    .hero::after { right: -80px; bottom: -110px; width: 330px; height: 330px; background: rgba(68, 201, 232, 0.18); }

    .hero-copy { position: relative; z-index: 2; align-self: center; min-width: 0; max-width: 660px; }
    .hero-copy h1, .hero-copy p, .hero-actions { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
    .eyebrow { margin-bottom: 16px; color: var(--ink); font-size: 0.74rem; font-weight: 900; letter-spacing: 0.18em; text-transform: uppercase; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { max-width: 650px; margin-bottom: 18px; font-size: clamp(3.2rem, 8vw, 7.2rem); font-weight: 900; letter-spacing: -0.095em; line-height: 0.84; }
    h1 em { color: white; font-style: normal; text-shadow: 4px 4px 0 var(--ink); }
    .hero-copy p { max-width: 510px; margin-bottom: 24px; color: rgba(32, 41, 67, 0.79); font-size: clamp(1rem, 1.8vw, 1.16rem); font-weight: 700; }

    .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
    .primary-button, .secondary-button, .small-button {
      border: 2px solid var(--ink);
      border-radius: 14px;
      color: var(--ink);
      background: white;
      box-shadow: 0 5px 0 var(--ink);
      cursor: pointer;
      font-weight: 900;
      transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
    }
    .primary-button { min-height: 52px; padding: 0 21px; background: var(--ink); color: white; }
    .secondary-button { min-height: 48px; padding: 0 18px; background: var(--yellow); }
    .small-button { min-height: 38px; padding: 0 13px; font-size: 0.82rem; }
    .primary-button:hover, .secondary-button:hover, .small-button:hover { filter: brightness(1.03); transform: translateY(-2px); box-shadow: 0 7px 0 var(--ink); }
    .primary-button:active, .secondary-button:active, .small-button:active { transform: translateY(3px); box-shadow: 0 2px 0 var(--ink); }
    .button-note { color: rgba(32, 41, 67, 0.68); font-size: 0.75rem; font-weight: 900; }

    .hero-art { position: relative; z-index: 1; display: grid; min-height: 280px; place-items: center; }
    .hero-art-card { position: relative; width: min(100%, 390px); aspect-ratio: 1.05; padding: 24px; border: 2px solid var(--ink); border-radius: 28px; background: rgba(255, 255, 255, 0.26); transform: rotate(4deg); }
    .hero-art-card::before { position: absolute; inset: 12px; border: 2px dashed rgba(32, 41, 67, 0.24); border-radius: 20px; content: ""; }
    .art-label { position: relative; display: flex; justify-content: space-between; color: var(--ink); font-size: 0.72rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; }
    .art-number { position: absolute; right: 17px; bottom: 14px; color: rgba(32, 41, 67, 0.65); font-size: 3rem; font-weight: 900; letter-spacing: -0.1em; }
    .hero-kart { position: absolute; top: 50%; left: 50%; width: 182px; height: 128px; transform: translate(-50%, -42%) rotate(-8deg); }
    .hero-kart-shadow { position: absolute; right: -10px; bottom: -18px; width: 190px; height: 28px; border-radius: 50%; background: rgba(32, 41, 67, 0.2); filter: blur(3px); }
    .hero-kart-body { position: absolute; inset: 28px 12px 18px; border: 5px solid var(--ink); border-radius: 44px 52px 24px 24px; background: var(--coral); box-shadow: inset -18px -12px 0 rgba(183, 55, 72, 0.19); }
    .hero-kart-nose { position: absolute; top: 17px; right: 4px; width: 82px; height: 65px; border: 5px solid var(--ink); border-radius: 18px 34px 22px 25px; background: #ffdb6f; transform: rotate(-10deg); }
    .hero-kart-window { position: absolute; top: 16px; left: 45px; width: 72px; height: 48px; border: 5px solid var(--ink); border-radius: 42% 55% 28% 34%; background: #75d8ea; transform: rotate(-16deg); }
    .hero-kart-eye { position: absolute; top: 29px; right: 19px; width: 10px; height: 15px; border-radius: 50%; background: var(--ink); }
    .hero-kart-wheel { position: absolute; bottom: 4px; width: 32px; height: 46px; border: 5px solid var(--ink); border-radius: 15px; background: #37415c; }
    .hero-kart-wheel.left { left: 18px; }
    .hero-kart-wheel.right { right: 16px; }
    .hero-kart-flame { position: absolute; top: 68px; left: -18px; width: 34px; height: 24px; border: 4px solid var(--ink); border-radius: 50% 18% 50% 50%; background: var(--yellow); transform: rotate(-9deg); }

    .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin: clamp(42px, 7vw, 82px) 0 20px; }
    .section-heading h2 { margin-bottom: 5px; font-size: clamp(1.9rem, 3.2vw, 3rem); letter-spacing: -0.08em; line-height: 0.96; }
    .section-heading p { margin-bottom: 0; color: var(--muted); font-weight: 700; }
    .section-kicker { color: var(--coral-dark); font-size: 0.71rem; font-weight: 900; letter-spacing: 0.16em; text-transform: uppercase; }

    .garage-layout { display: grid; grid-template-columns: minmax(240px, 0.72fr) minmax(360px, 1.4fr) minmax(240px, 0.7fr); align-items: start; gap: 18px; }
    .panel { border: 1px solid var(--line); border-radius: 23px; background: var(--card); box-shadow: 0 10px 30px rgba(73, 65, 105, 0.07); }
    .panel-pad { padding: 22px; }
    .panel-title { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 18px; }
    .panel-title h3 { margin: 0; font-size: 1rem; letter-spacing: -0.04em; }
    .tiny-label { color: var(--muted); font-size: 0.66rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; }

    .build-preview { position: relative; min-height: 165px; margin: -22px -22px 18px; overflow: hidden; border-bottom: 1px solid var(--line); border-radius: 23px 23px 0 0; background: linear-gradient(135deg, #a8ebef, #f4f5a8); }
    .build-preview::before { position: absolute; right: -30px; bottom: -70px; width: 220px; height: 160px; border: 25px solid rgba(255, 255, 255, 0.35); border-radius: 50%; content: ""; }
    .mini-kart { position: absolute; top: 50%; left: 50%; width: 170px; height: 94px; transform: translate(-50%, -43%) rotate(-5deg); }
    .mini-kart .body { position: absolute; inset: 24px 10px 16px; border: 4px solid var(--ink); border-radius: 38px 50px 18px 18px; background: var(--coral); }
    .mini-kart .hood { position: absolute; top: 11px; right: 0; width: 78px; height: 52px; border: 4px solid var(--ink); border-radius: 22px 32px 18px 22px; background: var(--yellow); transform: rotate(-9deg); }
    .mini-kart .glass { position: absolute; top: 14px; left: 42px; width: 58px; height: 34px; border: 4px solid var(--ink); border-radius: 50%; background: var(--cyan); transform: rotate(-12deg); }
    .mini-kart .wheel { position: absolute; bottom: 1px; width: 23px; height: 36px; border: 4px solid var(--ink); border-radius: 12px; background: #3c4861; }
    .mini-kart .wheel.one { left: 19px; } .mini-kart .wheel.two { right: 17px; }
    .mini-kart .flag { position: absolute; top: -17px; left: 65px; width: 4px; height: 38px; background: var(--ink); }
    .mini-kart .flag::after { position: absolute; top: 0; left: 3px; width: 27px; height: 17px; border: 3px solid var(--ink); border-radius: 2px 8px 8px 2px; background: var(--lime); content: ""; }

    .build-list { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
    .build-list li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-bottom: 1px dashed var(--line); }
    .build-list li:last-child { border-bottom: 0; }
    .build-part-name { font-size: 0.78rem; font-weight: 900; }
    .build-part-slot { display: block; margin-bottom: 2px; color: var(--muted); font-size: 0.62rem; font-weight: 900; letter-spacing: 0.12em; text-transform: uppercase; }
    .build-part-code { align-self: center; min-width: 31px; padding: 4px; border-radius: 8px; color: var(--ink); background: var(--yellow); font-size: 0.64rem; font-weight: 900; text-align: center; }

    .part-groups { display: grid; gap: 16px; }
    .part-group { padding: 17px; }
    .part-group-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
    .part-group-heading h3 { margin: 0; font-size: 0.86rem; letter-spacing: 0.02em; text-transform: uppercase; }
    .part-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .part-card { position: relative; min-height: 132px; padding: 13px; overflow: hidden; border: 2px solid transparent; border-radius: 16px; color: var(--ink); background: #f7f8fa; cursor: pointer; text-align: left; transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
    .part-card:hover { transform: translateY(-3px); border-color: rgba(32, 41, 67, 0.3); box-shadow: 0 7px 0 rgba(32, 41, 67, 0.08); }
    .part-card.selected { border-color: var(--ink); background: #fff; box-shadow: 4px 4px 0 var(--ink); }
    .part-card.selected::after { position: absolute; top: 8px; right: 8px; display: grid; width: 21px; height: 21px; place-items: center; border-radius: 50%; color: white; background: var(--coral); content: "OK"; font-size: 0.52rem; font-weight: 900; }
    .part-icon { display: grid; width: 34px; height: 28px; place-items: center; margin-bottom: 11px; border: 2px solid var(--ink); border-radius: 9px; color: var(--ink); background: var(--yellow); font-size: 0.57rem; font-weight: 900; }
    .part-card:nth-child(2) .part-icon { background: var(--cyan); }
    .part-card:nth-child(3) .part-icon { background: var(--lime); }
    .part-card strong { display: block; max-width: 92px; font-size: 0.75rem; line-height: 1.1; }
    .part-card small { display: block; margin-top: 5px; color: var(--muted); font-size: 0.64rem; font-weight: 700; line-height: 1.15; }

    .tune-card { position: sticky; top: 98px; }
    .score-block { display: flex; align-items: end; justify-content: space-between; gap: 10px; margin-bottom: 20px; }
    .score-number { font-size: 3.9rem; font-weight: 900; letter-spacing: -0.12em; line-height: 0.8; }
    .score-unit { margin-bottom: 5px; color: var(--muted); font-size: 0.68rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
    .synergy-pill { padding: 7px 9px; border-radius: 10px; color: var(--ink); background: var(--yellow); font-size: 0.66rem; font-weight: 900; text-align: center; }
    .synergy-pill strong { display: block; font-size: 1.05rem; }
    .stat-list { display: grid; gap: 13px; margin: 0; }
    .stat-row { display: grid; grid-template-columns: 76px 1fr 35px; align-items: center; gap: 8px; font-size: 0.68rem; font-weight: 900; }
    .stat-row dt { color: var(--muted); }
    .stat-row dd { margin: 0; }
    .stat-bar { height: 9px; overflow: hidden; border-radius: 99px; background: #edf0f4; }
    .stat-bar span { display: block; width: 0; height: 100%; border-radius: inherit; background: var(--coral); transition: width 260ms ease; }
    .stat-row:nth-child(2) .stat-bar span { background: var(--cyan); }
    .stat-row:nth-child(3) .stat-bar span { background: var(--lime); }
    .stat-row:nth-child(4) .stat-bar span { background: var(--violet); }
    .stat-row:nth-child(5) .stat-bar span { background: var(--yellow); }
    .stat-row:nth-child(6) .stat-bar span { background: #ff9c79; }
    .tune-tip { margin: 21px 0 0; padding: 12px; border-radius: 13px; color: #5d527b; background: #f0eefe; font-size: 0.72rem; font-weight: 800; }

    .track-section { margin-top: clamp(48px, 8vw, 92px); }
    .track-picker { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; }
    .track-card { position: relative; min-height: 168px; padding: 16px; overflow: hidden; border: 2px solid transparent; border-radius: 21px; color: var(--ink); background: white; cursor: pointer; text-align: left; transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease; }
    .track-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
    .track-card.selected { border-color: var(--ink); box-shadow: 5px 5px 0 var(--ink); }
    .track-color { position: absolute; inset: 0 0 auto; height: 78px; opacity: 0.9; background: linear-gradient(135deg, var(--track-a), var(--track-b)); }
    .track-color::after { position: absolute; right: -10px; bottom: -32px; width: 145px; height: 80px; border: 17px solid rgba(255,255,255,0.33); border-radius: 50%; content: ""; }
    .track-content { position: relative; z-index: 1; padding-top: 55px; }
    .track-badge { display: inline-flex; margin-bottom: 8px; padding: 4px 7px; border-radius: 6px; color: var(--ink); background: rgba(255,255,255,0.8); font-size: 0.56rem; font-weight: 900; letter-spacing: 0.08em; }
    .track-card strong { display: block; font-size: 0.82rem; line-height: 1.05; }
    .track-card small { display: block; margin-top: 6px; color: var(--muted); font-size: 0.65rem; font-weight: 700; }

    .race-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 15px; }
    .race-toolbar h1 { margin: 0; font-size: clamp(2.1rem, 5vw, 4.5rem); line-height: 0.82; }
    .race-toolbar h1 span { color: var(--coral); }
    .race-meta { display: flex; flex-wrap: wrap; align-items: center; justify-content: end; gap: 10px; }
    .race-meta-chip { display: flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 13px; border: 1px solid var(--line); border-radius: 12px; color: var(--muted); background: rgba(255,255,255,0.75); font-size: 0.74rem; font-weight: 900; }
    .race-meta-chip strong { color: var(--ink); }

    .race-layout { display: grid; grid-template-columns: minmax(0, 1fr) 284px; gap: 16px; }
    .race-stage { position: relative; aspect-ratio: 16 / 9; min-height: 420px; overflow: hidden; border: 3px solid var(--ink); border-radius: 28px; background: #ffd99b; box-shadow: 8px 8px 0 var(--ink); isolation: isolate; }
    .race-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
    #gameCanvas { z-index: 2; }
    #atmosphereCanvas { z-index: 1; }
    .race-vignette { position: absolute; z-index: 3; inset: 0; pointer-events: none; box-shadow: inset 0 0 0 3px rgba(255,255,255,0.19), inset 0 -90px 100px rgba(32,41,67,0.12); }
    .stage-label { position: absolute; z-index: 4; top: 13px; left: 16px; padding: 6px 9px; border-radius: 8px; color: var(--ink); background: rgba(255,255,255,0.78); font-size: 0.62rem; font-weight: 900; letter-spacing: 0.1em; text-transform: uppercase; }
    .countdown { position: absolute; z-index: 8; top: 50%; left: 50%; color: white; font-size: clamp(5rem, 16vw, 12rem); font-weight: 900; letter-spacing: -0.13em; line-height: 0.8; pointer-events: none; text-shadow: 8px 8px 0 var(--ink); transform: translate(-50%, -55%) rotate(-7deg); animation: pop-in 620ms cubic-bezier(.2,1.4,.4,1); }
    .race-toast { position: absolute; z-index: 8; right: 17px; bottom: 16px; max-width: 270px; padding: 10px 13px; border: 2px solid var(--ink); border-radius: 12px; color: var(--ink); background: rgba(255,255,255,0.87); font-size: 0.72rem; font-weight: 900; opacity: 0; transform: translateY(10px); transition: opacity 180ms ease, transform 180ms ease; pointer-events: none; }
    .race-toast.show { opacity: 1; transform: translateY(0); }
    @keyframes pop-in { 0% { opacity: 0; transform: translate(-50%, -55%) scale(0.3) rotate(-20deg); } 70% { transform: translate(-50%, -55%) scale(1.08) rotate(-7deg); } 100% { opacity: 1; transform: translate(-50%, -55%) scale(1) rotate(-7deg); } }

    .race-side { display: grid; align-content: start; gap: 12px; }
    .hud-card { padding: 16px; border: 1px solid var(--line); border-radius: 19px; background: rgba(255,255,255,0.87); box-shadow: 0 8px 24px rgba(73,65,105,0.07); }
    .hud-card h2 { margin-bottom: 10px; font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; }
    .lap-readout { display: flex; align-items: end; justify-content: space-between; gap: 10px; }
    .lap-number { font-size: 3.1rem; font-weight: 900; letter-spacing: -0.12em; line-height: 0.8; }
    .lap-number small { color: var(--muted); font-size: 1.1rem; letter-spacing: -0.08em; }
    .race-clock { color: var(--muted); font-size: 0.85rem; font-weight: 900; }
    .progress-track { height: 10px; margin-top: 14px; overflow: hidden; border-radius: 99px; background: #ecedf4; }
    .progress-track span { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, var(--coral), var(--yellow)); }
    .standing-list { display: grid; gap: 6px; margin: 0; padding: 0; list-style: none; }
    .standing-list li { display: grid; grid-template-columns: 22px 1fr auto; align-items: center; gap: 7px; padding: 7px 8px; border-radius: 9px; background: #f8f8fb; font-size: 0.7rem; font-weight: 900; }
    .standing-list li.player { color: var(--ink); background: #fff2c0; }
    .standing-place { color: var(--muted); }
    .standing-dot { width: 9px; height: 9px; border: 1px solid var(--ink); border-radius: 50%; background: var(--coral); }
    .standing-time { color: var(--muted); font-size: 0.62rem; }
    .minimap-wrap { display: grid; place-items: center; padding: 8px; border-radius: 13px; background: #eef5e8; }
    #minimap { display: block; width: 100%; height: auto; }
    .control-card { color: var(--muted); font-size: 0.7rem; font-weight: 800; }
    .control-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 5px 0; }
    kbd { min-width: 25px; padding: 3px 5px; border: 1px solid rgba(32,41,67,0.2); border-bottom-width: 3px; border-radius: 5px; color: var(--ink); background: white; font-size: 0.6rem; font-weight: 900; text-align: center; }
    .race-footer { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 15px; margin-top: 18px; color: var(--muted); font-size: 0.76rem; font-weight: 800; }

    .finish-overlay { position: absolute; z-index: 12; inset: 0; display: grid; place-items: center; padding: 20px; background: rgba(32,41,67,0.35); backdrop-filter: blur(5px); }
    .finish-overlay[hidden] { display: none !important; }
    .finish-card { width: min(430px, 100%); padding: 28px; border: 3px solid var(--ink); border-radius: 24px; background: var(--paper); box-shadow: 7px 7px 0 var(--ink); text-align: center; animation: finish-in 420ms cubic-bezier(.2,1.35,.4,1); }
    @keyframes finish-in { from { opacity: 0; transform: translateY(20px) rotate(3deg) scale(0.9); } to { opacity: 1; transform: none; } }
    .finish-sticker { display: inline-block; margin-bottom: 11px; padding: 7px 10px; border-radius: 8px; color: var(--ink); background: var(--yellow); font-size: 0.68rem; font-weight: 900; letter-spacing: 0.14em; transform: rotate(-3deg); }
    .finish-card h2 { margin-bottom: 8px; font-size: 2.7rem; letter-spacing: -0.1em; line-height: 0.86; }
    .finish-card p { margin-bottom: 19px; color: var(--muted); font-weight: 800; }
    .finish-results { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 20px; }
    .finish-result { padding: 10px 5px; border-radius: 11px; background: #f1f4f7; }
    .finish-result strong { display: block; font-size: 1.4rem; letter-spacing: -0.08em; }
    .finish-result small { color: var(--muted); font-size: 0.58rem; font-weight: 900; letter-spacing: 0.08em; text-transform: uppercase; }
    .finish-actions { display: flex; justify-content: center; gap: 9px; }

    .touch-controls { display: none; grid-template-columns: 1fr 1fr 1fr; gap: 10px; max-width: 460px; margin: 18px auto 0; }
    .touch-button { min-height: 56px; border: 2px solid var(--ink); border-radius: 16px; color: var(--ink); background: rgba(255,255,255,0.9); box-shadow: 0 4px 0 var(--ink); cursor: pointer; font-weight: 900; touch-action: none; user-select: none; }
    .touch-button.accent { background: var(--yellow); }
    .touch-button.drift { background: #e8ddff; }
    .touch-button:active, .touch-button.pressed { transform: translateY(3px); box-shadow: 0 1px 0 var(--ink); }

    .footer-note { margin-top: 46px; color: var(--muted); font-size: 0.72rem; font-weight: 700; text-align: center; }
    .footer-note a { color: var(--coral-dark); font-weight: 900; }

    @media (max-width: 1100px) {
      .garage-layout { grid-template-columns: minmax(220px, 0.62fr) minmax(330px, 1fr); }
      .tune-card { grid-column: span 2; position: static; }
      .stat-list { grid-template-columns: repeat(3, 1fr); }
      .track-picker { grid-template-columns: repeat(3, 1fr); }
      .track-card:last-child { grid-column: span 2; }
    }

    @media (max-width: 820px) {
      .topbar { flex-wrap: wrap; gap: 12px; }
      .top-actions { width: 100%; min-width: 0; flex-wrap: wrap; justify-content: space-between; }
      .main-nav { order: 3; width: 100%; justify-content: center; }
      .hero { grid-template-columns: 1fr; min-height: 0; }
      .hero-art { min-height: 220px; }
      .race-layout { grid-template-columns: 1fr; }
      .race-side { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .race-side .hud-card:first-child, .race-side .minimap-card { grid-column: span 2; }
      .touch-controls { display: grid; }
    }

    @media (max-width: 610px) {
      .page-main { padding: 22px 13px 46px; }
      .topbar { padding-inline: 14px; }
      .brand-sub { display: none; }
      .status-chip { padding-inline: 8px; font-size: 0.61rem; }
      .status-chip.best { display: none; }
      .hero { padding: 29px 22px 21px; border-radius: 25px; }
      h1 { max-width: 100%; font-size: clamp(2.7rem, 14.2vw, 4.5rem); overflow-wrap: break-word; }
      .hero-art { min-height: 190px; }
      .hero-art-card { width: 88%; }
      .button-note { max-width: 130px; }
      .section-heading { align-items: start; flex-direction: column; gap: 8px; }
      .garage-layout { grid-template-columns: 1fr; }
      .tune-card { grid-column: auto; }
      .stat-list { grid-template-columns: repeat(2, 1fr); }
      .part-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .track-picker { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .track-card:last-child { grid-column: auto; }
      .race-toolbar { align-items: start; flex-direction: column; }
      .race-meta { justify-content: start; }
      .race-stage { min-height: 230px; border-radius: 20px; box-shadow: 5px 5px 0 var(--ink); }
      .race-side { grid-template-columns: 1fr; }
      .race-side .hud-card:first-child, .race-side .minimap-card { grid-column: auto; }
      .race-footer { align-items: start; flex-direction: column; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { scroll-behavior: auto !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
    }
