:root {
  --ink: #173d39;
  --ink-soft: #3f6e63;
  --leaf: #1c7a57;
  --leaf-dark: #0f4d43;
  --leaf-pale: #e5f0c5;
  --mango: #f5c84d;
  --mango-dark: #da922c;
  --guava: #f16f79;
  --water: #64d6c8;
  --cream: #fff9e9;
  --white: #ffffff;
  --shadow: 0 24px 70px rgba(16, 65, 51, 0.16);
  --soft-shadow: 0 10px 28px rgba(16, 65, 51, 0.12);
  color: var(--ink);
  background: #eef2c8;
  font-family: "Avenir Next", "Trebuchet MS", "Segoe UI", sans-serif;
  font-synthesis: none;
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: #eef2c8;
}

body {
  margin: 0;
  min-height: 100vh;
  overflow-x: hidden;
  background:
    radial-gradient(circle at 85% 5%, rgba(245, 200, 77, 0.24), transparent 24rem),
    linear-gradient(135deg, #f9f5d7 0%, #d8ecc0 52%, #a8dcb7 100%);
}

body::before {
  position: fixed;
  z-index: 10;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  content: "";
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.32'/%3E%3C/svg%3E");
  mix-blend-mode: multiply;
}

button {
  border: 0;
  font: inherit;
}

button:focus-visible {
  outline: 4px solid rgba(241, 111, 121, 0.64);
  outline-offset: 4px;
}

button:disabled {
  cursor: not-allowed;
}

.app-shell {
  position: relative;
  width: min(100%, 1440px);
  min-height: 100vh;
  margin: 0 auto;
  padding: 34px clamp(18px, 4vw, 64px) 48px;
}

.screen {
  width: min(100%, 1210px);
  margin: 0 auto;
}

.screen[hidden] {
  display: none;
}

.screen--active {
  animation: screen-in 420ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.eyebrow {
  margin: 0 0 12px;
  color: var(--leaf);
  font-size: 0.72rem;
  font-weight: 900;
  letter-spacing: 0.18em;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
h3 {
  letter-spacing: -0.055em;
  font-family: Georgia, "Times New Roman", serif;
}

.home-screen {
  display: grid;
}

.home-copy {
  position: relative;
  z-index: 2;
  align-self: center;
  max-width: 540px;
  padding: clamp(44px, 7vw, 96px) 0;
}

.home-copy h1 {
  max-width: 520px;
  margin-bottom: 24px;
  color: var(--leaf-dark);
  font-size: clamp(4.2rem, 10vw, 8.8rem);
  line-height: 0.78;
}

.home-copy h1 span {
  color: var(--guava);
  font-style: italic;
}

.hero-text {
  max-width: 420px;
  margin-bottom: 34px;
  color: var(--ink-soft);
  font-size: clamp(1rem, 1.6vw, 1.2rem);
  line-height: 1.6;
}

.home-actions,
.result-actions {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 52px;
  padding: 0 21px;
  border-radius: 999px;
  cursor: pointer;
  font-size: 0.92rem;
  font-weight: 850;
  transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
}

.button:hover {
  transform: translateY(-3px);
}

.button--primary {
  gap: 18px;
  color: #173b34;
  background: var(--mango);
  box-shadow: 0 9px 0 var(--mango-dark), 0 20px 30px rgba(191, 128, 35, 0.2);
}

.button--primary:hover {
  box-shadow: 0 6px 0 var(--mango-dark), 0 20px 30px rgba(191, 128, 35, 0.28);
}

.button--ghost {
  color: var(--ink);
  background: rgba(255, 255, 255, 0.62);
  box-shadow: inset 0 0 0 1px rgba(23, 61, 57, 0.14);
}

.button--ghost:hover {
  background: rgba(255, 255, 255, 0.92);
}

.home-note {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 36px;
  color: var(--ink-soft);
  font-size: 0.78rem;
  font-weight: 750;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: var(--guava);
  box-shadow: 0 0 0 5px rgba(241, 111, 121, 0.16);
}

.home-art {
  position: absolute;
  z-index: 0;
  top: 34px;
  right: 0;
  width: min(61vw, 730px);
  min-height: 650px;
  overflow: hidden;
  border-radius: 44px;
  background:
    linear-gradient(90deg, rgba(239, 242, 200, 0.98) 0%, rgba(239, 242, 200, 0.1) 42%, rgba(15, 77, 67, 0.08) 100%),
    url("../assets/jungle-horizon.png") center / cover;
  box-shadow: var(--shadow);
  isolation: isolate;
}

.home-art::after {
  position: absolute;
  z-index: -1;
  inset: 0;
  content: "";
  background: linear-gradient(180deg, rgba(18, 87, 69, 0.05), rgba(10, 60, 49, 0.34));
}

.sun-disc {
  position: absolute;
  top: 13%;
  right: 18%;
  width: 110px;
  height: 110px;
  border-radius: 50%;
  background: rgba(255, 246, 174, 0.72);
  box-shadow: 0 0 80px 30px rgba(255, 234, 127, 0.2);
}

.home-canopy {
  position: absolute;
  border-radius: 50%;
  filter: blur(1px);
}

.home-canopy--back {
  right: -50px;
  bottom: -70px;
  width: 430px;
  height: 240px;
  background: #0f5c4d;
  box-shadow: -130px 70px 0 #1b7c5a, -320px 88px 0 #2b9b6c;
}

.home-canopy--front {
  bottom: -84px;
  left: -74px;
  width: 390px;
  height: 220px;
  background: #145d4d;
  box-shadow: 180px 46px 0 #1b8661, 410px 78px 0 #0f6b54;
}

.home-vine {
  position: absolute;
  width: 170px;
  height: 250px;
  border: 3px solid rgba(24, 108, 75, 0.78);
  border-top: 0;
  border-left-color: transparent;
  border-radius: 0 0 90px 90px;
}

.home-vine--left {
  top: -70px;
  left: 60px;
  transform: rotate(15deg);
}

.home-vine--right {
  top: -92px;
  right: 74px;
  transform: rotate(-19deg);
}

.home-character {
  position: absolute;
  z-index: 3;
  right: 29%;
  bottom: 12%;
  width: 144px;
  height: 205px;
  animation: character-float 3.6s ease-in-out infinite;
}

.character-body {
  position: absolute;
  bottom: 0;
  left: 20px;
  width: 110px;
  height: 142px;
  border: 7px solid #195d50;
  border-radius: 48% 48% 35% 35%;
  background: #f29959;
  box-shadow: inset -13px -12px 0 rgba(180, 76, 65, 0.16);
}

.character-leaf {
  position: absolute;
  z-index: 2;
  top: 3px;
  left: 24px;
  width: 99px;
  height: 58px;
  border: 6px solid #195d50;
  border-radius: 90% 10% 90% 10%;
  background: #9ccd47;
  transform: rotate(-13deg);
}

.character-eye {
  position: absolute;
  z-index: 3;
  top: 89px;
  width: 18px;
  height: 24px;
  border-radius: 50%;
  background: #fff7d2;
  box-shadow: inset 0 -3px 0 rgba(23, 61, 57, 0.12);
}

.character-eye::after {
  position: absolute;
  right: 4px;
  bottom: 5px;
  width: 7px;
  height: 8px;
  border-radius: 50%;
  content: "";
  background: #24345e;
}

.character-eye--left {
  left: 48px;
}

.character-eye--right {
  left: 84px;
}

.character-smile {
  position: absolute;
  z-index: 3;
  top: 128px;
  left: 60px;
  width: 38px;
  height: 22px;
  border-bottom: 4px solid #24345e;
  border-radius: 0 0 40px 40px;
}

.character-backpack {
  position: absolute;
  right: -2px;
  bottom: 29px;
  width: 34px;
  height: 72px;
  border: 5px solid #195d50;
  border-radius: 10px;
  background: var(--mango);
  transform: rotate(9deg);
}

.home-flower {
  position: absolute;
  z-index: 4;
  bottom: 70px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--guava);
  box-shadow: 0 -23px 0 #f6a45c, 23px 0 0 #f6a45c, 0 23px 0 #f6a45c, -23px 0 0 #f6a45c;
}

.home-flower::after {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  content: "";
  background: var(--mango);
}

.home-flower--one {
  left: 16%;
}

.home-flower--two {
  right: 10%;
  transform: scale(0.66);
}

.screen-heading,
.game-toolbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24px;
}

.screen-heading {
  margin: 45px 0 34px;
}

.screen-heading h2,
.result-card h2 {
  margin-bottom: 8px;
  color: var(--leaf-dark);
  font-size: clamp(2.8rem, 6vw, 5rem);
  line-height: 0.92;
}

.screen-subtitle {
  margin: 0;
  color: var(--ink-soft);
}

.hero-select {
  display: grid;
  grid-template-columns: minmax(220px, 0.72fr) 1.28fr;
  min-height: 230px;
  margin: 0 0 38px;
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.62);
  border-radius: 30px;
  background: rgba(255, 249, 233, 0.68);
  box-shadow: var(--soft-shadow);
}

.hero-roster-art {
  min-height: 230px;
  background:
    linear-gradient(90deg, rgba(16, 83, 68, 0.08), rgba(16, 83, 68, 0.42)),
    url("../assets/jungle-horizon.png") 18% 62% / cover;
}

.hero-select-copy {
  align-self: center;
  padding: 26px clamp(22px, 4vw, 46px);
}

.hero-select-copy h3 {
  margin-bottom: 18px;
  color: var(--leaf-dark);
  font-size: clamp(2rem, 4vw, 3.1rem);
  line-height: 0.94;
}

.hero-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.hero-button {
  position: relative;
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) auto;
  align-items: center;
  gap: 10px;
  min-height: 68px;
  padding: 9px 11px;
  border: 1px solid rgba(23, 61, 57, 0.1);
  border-radius: 16px;
  cursor: pointer;
  text-align: left;
  color: var(--ink);
  background: rgba(255, 255, 255, 0.68);
  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
}

.hero-button:not(:disabled):hover {
  transform: translateY(-3px);
  box-shadow: 0 9px 20px rgba(16, 65, 51, 0.12);
}

.hero-button--selected {
  border-color: var(--hero-primary);
  background: var(--white);
  box-shadow: inset 0 -4px 0 color-mix(in srgb, var(--hero-primary) 48%, transparent);
}

.hero-button--locked {
  opacity: 0.48;
}

.hero-portrait {
  position: relative;
  width: 42px;
  height: 48px;
  border: 3px solid var(--leaf-dark);
  border-radius: 48% 48% 38% 38%;
  background: var(--hero-primary);
  box-shadow: inset -5px -4px 0 rgba(0, 0, 0, 0.1);
}

.hero-portrait::before {
  position: absolute;
  top: -10px;
  left: 6px;
  width: 28px;
  height: 16px;
  border: 3px solid var(--leaf-dark);
  border-radius: 90% 10% 90% 10%;
  content: "";
  background: var(--hero-secondary);
  transform: rotate(-12deg);
}

.hero-portrait::after {
  position: absolute;
  top: 17px;
  left: 10px;
  width: 5px;
  height: 7px;
  border-radius: 50%;
  content: "";
  background: var(--leaf-dark);
  box-shadow: 14px 0 0 var(--leaf-dark);
}

.hero-portrait--nia::before {
  border-radius: 50% 50% 20% 80%;
  transform: rotate(18deg);
}

.hero-portrait--bo {
  border-radius: 34% 34% 42% 42%;
}

.hero-button-copy {
  display: grid;
  gap: 2px;
  min-width: 0;
}

.hero-button-copy strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1rem;
}

.hero-button-copy small {
  overflow: hidden;
  color: var(--ink-soft);
  font-size: 0.61rem;
  font-weight: 760;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-marker {
  color: var(--hero-primary);
  font-weight: 950;
}

.icon-button {
  display: inline-grid;
  width: 48px;
  height: 48px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 50%;
  color: var(--ink);
  cursor: pointer;
  background: rgba(255, 255, 255, 0.68);
  box-shadow: var(--soft-shadow);
  font-size: 1.2rem;
  font-weight: 900;
  transition: transform 180ms ease, background 180ms ease;
}

.icon-button:hover {
  transform: translateY(-2px) rotate(-4deg);
  background: var(--white);
}

.level-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.world-heading {
  display: flex;
  grid-column: 1 / -1;
  align-items: baseline;
  gap: 14px;
  padding: 24px 2px 2px;
  color: var(--leaf-dark);
}

.world-heading:first-child {
  padding-top: 0;
}

.world-kicker {
  color: var(--guava);
  font-size: 0.68rem;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.world-heading strong {
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.35rem;
}

.level-button {
  position: relative;
  display: grid;
  min-height: 154px;
  padding: 19px 20px;
  border-radius: 22px;
  cursor: pointer;
  text-align: left;
  background: rgba(255, 255, 255, 0.64);
  box-shadow: 0 2px 0 rgba(16, 65, 51, 0.06), var(--soft-shadow);
  transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
}

.level-button:not(:disabled):hover {
  transform: translateY(-5px);
  background: var(--white);
  box-shadow: 0 8px 0 rgba(241, 111, 121, 0.22), 0 24px 36px rgba(16, 65, 51, 0.14);
}

.level-number {
  color: var(--guava);
  font-size: 0.78rem;
  font-weight: 900;
  letter-spacing: 0.15em;
}

.level-name {
  align-self: end;
  color: var(--leaf-dark);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 1.28rem;
  font-weight: 700;
}

.level-meta {
  align-self: end;
  margin-top: 7px;
  color: var(--ink-soft);
  font-size: 0.72rem;
  font-weight: 750;
}

.level-goals {
  align-self: end;
  margin-top: 9px;
  color: var(--ink-soft);
  font-size: 0.64rem;
  font-weight: 850;
  letter-spacing: 0.02em;
}

.level-icon {
  position: absolute;
  top: 17px;
  right: 18px;
  color: var(--mango-dark);
  font-size: 1.2rem;
  font-weight: 900;
}

.level-button--complete {
  background: rgba(229, 240, 197, 0.84);
}

.level-button--locked {
  opacity: 0.58;
}

.levels-footer {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-top: 28px;
  color: var(--ink-soft);
  font-size: 0.79rem;
  font-weight: 800;
}

.text-button {
  padding: 4px 0;
  border-bottom: 1px solid currentColor;
  cursor: pointer;
  color: var(--ink-soft);
  background: transparent;
  font-size: 0.78rem;
  font-weight: 800;
}

.text-button:hover {
  color: var(--guava);
}

.screen--game {
  width: min(100%, 1280px);
}

.game-toolbar {
  align-items: center;
  padding: 8px 0 18px;
}

.game-title-wrap {
  flex: 1;
  text-align: center;
}

.game-title-wrap .eyebrow {
  margin-bottom: 4px;
}

.game-title-wrap h2 {
  margin: 0;
  color: var(--leaf-dark);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.4rem, 3vw, 2.2rem);
}

.game-toolbar-actions {
  display: flex;
  gap: 9px;
}

.game-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 160px;
  align-items: start;
  gap: 18px;
}

.game-frame {
  position: relative;
  overflow: hidden;
  border: 8px solid rgba(255, 249, 233, 0.88);
  border-radius: 31px;
  background: var(--leaf-dark);
  box-shadow: var(--shadow);
}

#game-canvas {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  image-rendering: auto;
}

.game-hud {
  position: absolute;
  z-index: 2;
  top: 17px;
  right: 17px;
  left: 17px;
  display: flex;
  justify-content: space-between;
  pointer-events: none;
}

.hud-chip {
  display: grid;
  gap: 3px;
  min-width: 92px;
  padding: 8px 12px;
  border: 1px solid rgba(255, 255, 255, 0.22);
  border-radius: 12px;
  color: var(--white);
  background: rgba(21, 71, 58, 0.72);
  backdrop-filter: blur(10px);
}

.hud-chip--mango strong {
  color: var(--mango);
}

.hud-chip--lives strong {
  color: #ffaaa8;
  letter-spacing: 0.08em;
}

.hud-chip--quest strong {
  color: #9ff0d1;
  font-size: 0.72rem;
  letter-spacing: 0.02em;
}

.hud-label {
  color: rgba(255, 255, 255, 0.66);
  font-size: 0.57rem;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.hud-chip strong {
  font-size: 0.93rem;
}

.pause-card {
  position: absolute;
  z-index: 4;
  top: 50%;
  left: 50%;
  width: min(90%, 310px);
  padding: 30px;
  border-radius: 24px;
  text-align: center;
  background: rgba(255, 249, 233, 0.94);
  box-shadow: var(--shadow);
  transform: translate(-50%, -50%);
}

.pause-card h3 {
  margin-bottom: 20px;
  font-size: 2.2rem;
}

.game-help {
  display: grid;
  gap: 10px;
}

.help-card {
  display: grid;
  justify-items: start;
  gap: 9px;
  padding: 16px;
  border-radius: 18px;
  color: var(--ink-soft);
  background: rgba(255, 255, 255, 0.54);
  box-shadow: 0 2px 0 rgba(16, 65, 51, 0.05);
  font-size: 0.76rem;
  font-weight: 800;
}

.help-icon {
  display: grid;
  min-width: 44px;
  min-height: 30px;
  place-items: center;
  border-radius: 9px;
  color: var(--leaf-dark);
  background: var(--leaf-pale);
  font-size: 0.95rem;
  font-weight: 900;
}

.help-card--tip {
  color: var(--ink);
  background: var(--mango);
}

.help-card--tip .help-icon {
  background: rgba(255, 249, 233, 0.58);
}

.touch-controls {
  display: none;
  justify-content: space-between;
  gap: 12px;
  padding: 16px 4px 0;
}

.touch-button {
  display: grid;
  width: 64px;
  height: 54px;
  place-items: center;
  border-radius: 18px;
  color: var(--leaf-dark);
  cursor: pointer;
  touch-action: none;
  background: rgba(255, 249, 233, 0.74);
  box-shadow: 0 4px 0 rgba(16, 65, 51, 0.11);
  font-size: 1.35rem;
  font-weight: 900;
}

.touch-button--jump {
  width: 88px;
  color: #5b3e26;
  background: var(--mango);
}

.touch-button--ability {
  color: var(--white);
  background: var(--guava);
  box-shadow: 0 4px 0 #c45461;
}

.touch-button.is-pressed {
  transform: translateY(3px);
  box-shadow: 0 1px 0 rgba(16, 65, 51, 0.11);
}

.result-screen {
  display: grid;
  min-height: calc(100vh - 110px);
  place-items: center;
}

.result-card {
  position: relative;
  width: min(100%, 600px);
  padding: clamp(34px, 7vw, 70px);
  border-radius: 38px;
  text-align: center;
  background: rgba(255, 249, 233, 0.86);
  box-shadow: var(--shadow);
}

.result-card h2 {
  font-size: clamp(3.1rem, 8vw, 5.6rem);
}

.result-card > p:not(.eyebrow) {
  color: var(--ink-soft);
}

.result-sticker {
  display: grid;
  width: 72px;
  height: 72px;
  margin: 0 auto 20px;
  place-items: center;
  border-radius: 23px;
  color: #684924;
  background: var(--mango);
  box-shadow: 0 8px 0 var(--mango-dark);
  font-size: 2.3rem;
  transform: rotate(-8deg);
}

.result-sticker--fail {
  color: var(--white);
  background: var(--guava);
  box-shadow: 0 8px 0 #c45461;
}

.result-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin: 28px 0 34px;
}

.result-stats div {
  display: grid;
  gap: 5px;
  padding: 13px 5px;
  border-radius: 14px;
  background: rgba(229, 240, 197, 0.75);
}

.result-stats span {
  color: var(--ink-soft);
  font-size: 0.68rem;
  font-weight: 800;
}

.result-stats strong {
  color: var(--leaf-dark);
  font-size: 1.08rem;
}

.result-actions {
  justify-content: center;
}

.result-goals {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  margin: -20px 0 28px;
}

.result-goal {
  padding: 8px 11px;
  border-radius: 999px;
  color: var(--ink-soft);
  background: rgba(255, 255, 255, 0.66);
  font-size: 0.7rem;
  font-weight: 850;
}

.result-goal--complete {
  color: var(--leaf-dark);
  background: var(--leaf-pale);
}

.result-actions .text-button {
  flex-basis: 100%;
}

.how-dialog {
  width: min(90vw, 450px);
  padding: 38px;
  border: 0;
  border-radius: 28px;
  color: var(--ink);
  background: var(--cream);
  box-shadow: var(--shadow);
}

.how-dialog::backdrop {
  background: rgba(8, 52, 45, 0.45);
  backdrop-filter: blur(5px);
}

.how-dialog h2 {
  margin-bottom: 18px;
  font-size: 3.4rem;
}

.how-dialog p:not(.eyebrow) {
  color: var(--ink-soft);
  line-height: 1.7;
}

.dialog-close {
  position: absolute;
  top: 16px;
  right: 16px;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

@keyframes screen-in {
  from {
    opacity: 0;
    transform: translateY(14px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes character-float {
  0%,
  100% {
    transform: translateY(0) rotate(-2deg);
  }
  50% {
    transform: translateY(-13px) rotate(2deg);
  }
}

@media (max-width: 900px) {
  .home-art {
    position: relative;
    top: auto;
    right: auto;
    grid-column: 1;
    width: 100%;
    min-height: 420px;
    margin-top: -30px;
  }

  .home-copy {
    padding-bottom: 38px;
  }

  .game-layout {
    grid-template-columns: 1fr;
  }

  .game-help {
    grid-template-columns: repeat(4, 1fr);
  }

  .help-card {
    min-height: 86px;
  }
}

@media (max-width: 640px) {
  .app-shell {
    padding: 20px 14px 30px;
  }

  .home-copy {
    padding-top: 34px;
  }

  .home-copy h1 {
    font-size: clamp(4.1rem, 19vw, 6.4rem);
  }

  .home-art {
    min-height: 340px;
    margin-top: -12px;
    border-radius: 27px;
  }

  .home-character {
    right: 25%;
    bottom: 11%;
    transform: scale(0.7);
    transform-origin: bottom right;
  }

  .screen-heading {
    margin-top: 28px;
  }

  .screen-heading h2 {
    font-size: 3.2rem;
  }

  .hero-select {
    grid-template-columns: 1fr;
    border-radius: 24px;
  }

  .hero-roster-art {
    min-height: 135px;
  }

  .hero-select-copy {
    padding: 22px 16px 24px;
  }

  .hero-grid {
    gap: 7px;
  }

  .hero-button {
    grid-template-columns: 34px minmax(0, 1fr);
    min-height: 62px;
    padding: 8px;
  }

  .hero-portrait {
    width: 34px;
    height: 40px;
  }

  .hero-marker {
    display: none;
  }

  .level-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .level-button {
    min-height: 142px;
    padding: 15px;
    border-radius: 18px;
  }

  .level-name {
    font-size: 1.08rem;
  }

  .levels-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .game-toolbar {
    gap: 9px;
  }

  .game-toolbar .icon-button {
    width: 42px;
    height: 42px;
  }

  .game-title-wrap h2 {
    font-size: 1.1rem;
  }

  .game-frame {
    border-width: 5px;
    border-radius: 20px;
  }

  .game-hud {
    top: 9px;
    right: 9px;
    left: 9px;
  }

  .hud-chip {
    min-width: 0;
    padding: 6px 7px;
    border-radius: 9px;
  }

  .hud-label {
    font-size: 0.48rem;
  }

  .hud-chip strong {
    font-size: 0.75rem;
  }

  .touch-controls {
    display: flex;
  }

  .touch-button {
    width: auto;
    min-width: 54px;
    flex: 1;
  }

  .touch-button--jump {
    flex: 1.2;
  }

  .result-screen {
    min-height: calc(100vh - 70px);
  }

  .result-card {
    padding: 34px 20px;
    border-radius: 28px;
  }

  .result-stats {
    gap: 5px;
  }
}

@media (max-width: 430px) {
  .level-grid {
    grid-template-columns: 1fr;
  }

  .world-heading {
    padding-top: 18px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-button {
    grid-template-columns: 38px minmax(0, 1fr) auto;
  }

  .hero-marker {
    display: inline;
  }

  .game-help {
    display: none;
  }

  .game-toolbar-actions {
    gap: 5px;
  }

  .hud-chip--lives {
    display: none;
  }

  .hud-chip--quest {
    display: none;
  }

  .result-stats strong {
    font-size: 0.9rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
