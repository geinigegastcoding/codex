<mxfile host="app.diagrams.net" modified="2026-10-10T00:00:00.000Z" agent="Codex" type="device"><diagram id="flow" name="Google Flow - Manual Workflow"><mxGraphModel grid="1" gridSize="24" page="0" pageWidth="1680" pageHeight="3680" background="#FBFAFC"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="heading" value="&lt;b&gt;Google Flow&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#615A6D;fontSize=48;" vertex="1" parent="1"><mxGeometry x="76" y="51" width="900" height="55" as="geometry"/></mxCell><mxCell id="subheading" value="Character video workflow" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#615A6D;fontSize=34;" vertex="1" parent="1"><mxGeometry x="76" y="117" width="1000" height="45" as="geometry"/></mxCell><mxCell id="description" value="You click Generate. The system prepares, tracks, reviews, and assembles." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontColor=#615A6D;fontSize=19;" vertex="1" parent="1"><mxGeometry x="76" y="171" width="1350" height="30" as="geometry"/></mxCell><mxCell id="banner" value="&lt;b&gt;MANUAL GENERATION / EXISTING FLOW CREDITS / OPTIONAL FREE MOTION TRANSFER&lt;/b&gt;&lt;br&gt;You click Generate and review every clip. The system prepares prompts, records spending, and assembles accepted footage." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E0DEE7;fontFamily=Arial;fontSize=18;spacing=18;" vertex="1" parent="1"><mxGeometry x="76" y="229" width="1528" height="112" as="geometry"/></mxCell><mxCell id="note-411" value="&lt;b&gt;How you use Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Open your existing signed-in project.&lt;br&gt;2. Copy the prepared shot prompt.&lt;br&gt;3. Attach its approved references.&lt;br&gt;4. Check settings and the live cost.&lt;br&gt;5. You click Generate and review.&lt;br&gt;6. Download the accepted clip.&lt;br&gt;&lt;br&gt;No agent clicks Generate for you.&lt;br&gt;The credit cap is planning guidance." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#78ABB0;fontFamily=Arial;fontSize=15;spacing=18;" vertex="1" parent="1"><mxGeometry x="1205" y="411" width="335" height="292" as="geometry"/></mxCell><mxCell id="note-814" value="&lt;b&gt;Best practical route first&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wan Animate can transfer a performance.&lt;br&gt;Its official hosted demo is unavailable.&lt;br&gt;Your 8 GB GPU needs a separate trial.&lt;br&gt;&lt;br&gt;Use Flow when no usable free route exists.&lt;br&gt;Check video-reference support in the UI.&lt;br&gt;Otherwise use first / last frames." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#C8A38D;fontFamily=Arial;fontSize=15;spacing=18;" vertex="1" parent="1"><mxGeometry x="134" y="814" width="340" height="244" as="geometry"/></mxCell><mxCell id="note-1980" value="&lt;b&gt;Example credit envelope&lt;/b&gt;&lt;br&gt;&lt;br&gt;24s source = three 8s shots.&lt;br&gt;Two attempts maximum per shot.&lt;br&gt;&lt;br&gt;Omni 360p video example:&lt;br&gt;3 shots x 2 attempts x 6 = 36 credits.&lt;br&gt;&lt;br&gt;Add image work and final operations.&lt;br&gt;Check the quote before each click.&lt;br&gt;The live Flow quote always wins.&lt;br&gt;This is an example, not your balance." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#78ABB0;fontFamily=Arial;fontSize=15;spacing=18;" vertex="1" parent="1"><mxGeometry x="134" y="1980" width="340" height="314" as="geometry"/></mxCell><mxCell id="note-2880" value="&lt;b&gt;What the system preserves&lt;/b&gt;&lt;br&gt;&lt;br&gt;Original files and source soundtrack.&lt;br&gt;Explicit character-to-reference mapping.&lt;br&gt;Accepted takes across retries.&lt;br&gt;Each review and spending decision.&lt;br&gt;&lt;br&gt;Audio restoration does not repair&lt;br&gt;generated lip-sync errors.&lt;br&gt;Full playback is the final gate." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#A297C2;fontFamily=Arial;fontSize=15;spacing=18;" vertex="1" parent="1"><mxGeometry x="134" y="2880" width="340" height="262" as="geometry"/></mxCell><mxCell id="intake" value="&lt;b&gt;Source clip + cast references&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;MP4 / MOV, up to 30s, 1-2 characters&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="408" width="460" height="80" as="geometry"/></mxCell><mxCell id="validate" value="&lt;b&gt;Validate and preserve originals&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Probe media; keep the complete source audio&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="530" width="460" height="100" as="geometry"/></mxCell><mxCell id="plan" value="&lt;b&gt;Build the shot plan&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Scene, actor mapping, action beats, shot lengths&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="672" width="460" height="100" as="geometry"/></mxCell><mxCell id="free_ready" value="&lt;b&gt;Free motion&lt;br&gt;transfer route&lt;br&gt;ready?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="818" width="270" height="154" as="geometry"/></mxCell><mxCell id="free_try" value="&lt;b&gt;Try Wan Animate replacement&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;You upload a short clip + character reference&lt;br&gt;Only with confirmed no-extra-charge access&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2FA;strokeColor=#95A8C2;fontColor=#3B4D65;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="839" width="335" height="112" as="geometry"/></mxCell><mxCell id="free_review" value="&lt;b&gt;Motion +&lt;br&gt;identity&lt;br&gt;approved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1237.5" y="993" width="270" height="154" as="geometry"/></mxCell><mxCell id="free_keep" value="&lt;b&gt;Keep the motion-transfer footage&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Finish locally with the original audio&lt;br&gt;Skip Flow regeneration and Flow upscaling&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EDF2FA;strokeColor=#95A8C2;fontColor=#3B4D65;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="1190" width="335" height="116" as="geometry"/></mxCell><mxCell id="authorize" value="&lt;b&gt;Approve the job + credit cap&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Image work, video attempts, final operations&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1010" width="460" height="104" as="geometry"/></mxCell><mxCell id="frames" value="&lt;b&gt;Prepare or reuse reference inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Cast frames; video reference only if supported&lt;br&gt;Check the live cost before generating images&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E5F5F5;strokeColor=#78ABB0;fontColor=#25484D;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1156" width="460" height="112" as="geometry"/></mxCell><mxCell id="refs_review" value="&lt;b&gt;Reference&lt;br&gt;inputs&lt;br&gt;approved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="1310" width="270" height="154" as="geometry"/></mxCell><mxCell id="refs_fix" value="&lt;b&gt;Revise the frame inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Fix identity, pose, or environment&lt;br&gt;Return to the approved credit envelope&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="134" y="1335" width="340" height="104" as="geometry"/></mxCell><mxCell id="lock" value="&lt;b&gt;Lock one copyable shot card&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Prompt, files, model, duration, aspect ratio&lt;br&gt;One supported input mode; one output&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1510" width="460" height="104" as="geometry"/></mxCell><mxCell id="budget" value="&lt;b&gt;Live quote&lt;br&gt;within approved&lt;br&gt;credit cap?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="1664" width="270" height="154" as="geometry"/></mxCell><mxCell id="budget_pause" value="&lt;b&gt;Pause with assets intact&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Balance, cost, or settings need inspection&lt;br&gt;Reconcile or renew the spending approval&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#CE9B97;fontColor=#784D48;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="1688" width="335" height="106" as="geometry"/></mxCell><mxCell id="generate" value="&lt;b&gt;You click Generate in Google Flow&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Copy the prompt; attach the approved inputs&lt;br&gt;Set model, duration, resolution, and one output&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E5F5F5;strokeColor=#78ABB0;fontColor=#25484D;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="1864" width="460" height="112" as="geometry"/></mxCell><mxCell id="confirmed" value="&lt;b&gt;Result saved&lt;br&gt;and spending&lt;br&gt;confirmed?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="2020" width="270" height="154" as="geometry"/></mxCell><mxCell id="inspect" value="&lt;b&gt;Inspect before any retry&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Unknown: check project history and usage&lt;br&gt;Failed: record the reason and reconcile cost&lt;br&gt;Content rejection: stop that request&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF0EE;strokeColor=#CE9B97;fontColor=#784D48;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="2040" width="335" height="114" as="geometry"/></mxCell><mxCell id="preview" value="&lt;b&gt;Preview with the original audio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Download, validate, and check against source timing&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="2220" width="460" height="104" as="geometry"/></mxCell><mxCell id="draft_review" value="&lt;b&gt;Identity&lt;br&gt;and timing&lt;br&gt;approved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="2370" width="270" height="154" as="geometry"/></mxCell><mxCell id="revise" value="&lt;b&gt;Revise only the rejected shot&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Record the issue; version the prompt&lt;br&gt;Keep every accepted asset&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="134" y="2395" width="340" height="104" as="geometry"/></mxCell><mxCell id="more" value="&lt;b&gt;More shots&lt;br&gt;to generate?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="2570" width="270" height="154" as="geometry"/></mxCell><mxCell id="next" value="&lt;b&gt;Select the next shot&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Reuse the approved character references&lt;br&gt;Return to settings and the cost check&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="2594" width="335" height="106" as="geometry"/></mxCell><mxCell id="upscale" value="&lt;b&gt;You upscale accepted Flow assets&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Verify the live cost again; keep the same take&lt;br&gt;Free-model footage skips this Flow step&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#E5F5F5;strokeColor=#78ABB0;fontColor=#25484D;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="2770" width="460" height="104" as="geometry"/></mxCell><mxCell id="assemble" value="&lt;b&gt;Stitch and restore source audio&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Normalize FPS; trim to the original timeline&lt;br&gt;Discard generated audio; mux the original once&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="2918" width="460" height="104" as="geometry"/></mxCell><mxCell id="final_review" value="&lt;b&gt;Full playback&lt;br&gt;and export&lt;br&gt;approved?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF1E7;strokeColor=#C8A38D;fontColor=#624936;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="700" y="3066" width="270" height="154" as="geometry"/></mxCell><mxCell id="fix_export" value="&lt;b&gt;Fix the final assembly&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Joins, duration, audio, or dimensions&lt;br&gt;Reopen the matching route for footage issues&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F0EDFC;strokeColor=#A297C2;fontColor=#35304E;fontFamily=Arial;fontSize=19;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="1205" y="3088" width="335" height="110" as="geometry"/></mxCell><mxCell id="export" value="&lt;b&gt;Export the reviewed final MP4&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Report resolution; retain clips + run record&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#EAF6EE;strokeColor=#88B294;fontColor=#345941;fontFamily=Arial;fontSize=22;strokeWidth=1.8;spacing=8;" vertex="1" parent="1"><mxGeometry x="605" y="3262" width="460" height="80" as="geometry"/></mxCell><mxCell id="connector-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#808793;strokeWidth=2;fontFamily=Arial;fontSize=11;fontColor=#808793;labelBackgroundColor=#FBFAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="intake" target="validate"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="connector-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#808793;strokeWidth=2;fontFamily=Arial;fontSize=11;fontColor=#808793;labelBackgroundColor=#FBFAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="validate" target="plan"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="connector-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#808793;strokeWidth=2;fontFamily=Arial;fontSize=11;fontColor=#808793;labelBackgroundColor=#FBFAFC;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitPerimeter=0;entryPerimeter=0;" edge="1" parent="1" source="plan" target="free_ready"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="connector-3" value="YES / OPTIONAL" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64A181;strokeWidth=2;fo