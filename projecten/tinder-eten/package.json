    "check:bundle": "node scripts/check-bundle.mjs",
    "test:pwa": "npm run build && node scripts/check-pwa.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4"
  }
}
