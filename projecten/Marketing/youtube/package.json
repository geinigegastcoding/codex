{
  "name": "practical-ai-youtube-pipeline",
  "version": "1.0.0",
  "description": "Local-first research, narration, and Remotion pipeline for original practical AI explainers",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@remotion/captions": "4.0.505",
    "@remotion/cli": "4.0.505",
    "@remotion/media": "4.0.505",
    "@remotion/zod-types": "4.0.505",
    "commander": "^14.0.0",
    "dotenv": "^17.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.505",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.505",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "^4.20.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.0"
  },
  "scripts": {
    "studio": "remotion studio",
    "dev": "npm run studio",
    "build": "remotion bundle",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts && tsc --noEmit",
    "test": "vitest run",
    "research:channels": "tsx scripts/cli.ts research:channels",
    "research:gallery": "tsx scripts/cli.ts research:gallery",
    "video:new": "tsx scripts/cli.ts video:new",
    "video:validate": "tsx scripts/cli.ts video:validate",
    "voice:generate": "tsx scripts/cli.ts voice:generate",
    "voice:regenerate": "tsx scripts/cli.ts voice:regenerate",
    "voice:stitch": "tsx scripts/cli.ts voice:stitch",
    "captions:build": "tsx scripts/cli.ts captions:build",
    "storyboard:build": "tsx scripts/cli.ts storyboard:build",
    "qa": "tsx scripts/cli.ts qa",
    "render": "tsx scripts/cli.ts render",
    "package": "tsx scripts/cli.ts package",
    "pipeline": "tsx scripts/cli.ts pipeline",
    "smoke:still": "remotion still src/index.ts SmokeTest out/smoke.png --frame=45 --scale=0.25",
    "smoke:render": "remotion render src/index.ts SmokeTest out/smoke.mp4 --scale=0.25 --frames=0-449 --codec=h264"
  },
  "sideEffects": ["*.css"]
}
