<Window x:Class="VibeKeepAlive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agentoff"
        Width="1324"
        Height="995"
        MinWidth="1180"
        MinHeight="887"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True">
    <Border Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
        <Grid Width="1448" Height="1088">
          <Grid Margin="30,38,30,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="276" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16">
                <Grid Margin="20,28,20,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="4,0,4,48" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource TextBrush}" VerticalAlignment="Center">
                            <Ellipse Width="9" Height="9" Fill="{DynamicResource WindowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="Agentoff" Foreground="{DynamicResource TextBrush}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Grid.Column="2" Text="v0.1.0" Foreground="{DynamicResource DimBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="1">
                        <Button x:Name="OverviewNav" Tag="Overview" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Overview">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,15,0" />
                                <TextBlock Text="Overview" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="AgentsNav" Tag="Agents" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Agents">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,15,0" />
                                <TextBlock Text="Agents" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNav" Tag="Settings" Click="Nav_Click" Style="{StaticResource NavButtonStyle}" AutomationProperties.Name="Settings">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Margin="0,0,15,0" />
                                <TextBlock Text="Settings" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="27,0,0,44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="106" />
                    <RowDefinition Height="434" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="OverviewPanel" Grid.RowSpan="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="106" />
                        <RowDefinition Height="434" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="20,0" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <TextBlock Text="Let your agents work. We’ll shut things down when they’re done." Foreground="{DynamicResource MutedBrush}" FontSize="16" />
                            </StackPanel>
                            <Button x:Name="MonitoringMenuButton" Grid.Column="1" Click="MonitoringMenu_Click" Style="{StaticResource CardButtonStyle}" Padding="16,10" Height="50" AutomationProperties.Name="Monitoring status and options">
                                <Button.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="{Binding PauseButtonText}" Click="Pause_Click" />
                                        <MenuItem Header="Activity log" Click="OpenActivity_Click" />
                                        <Separator />
                                        <MenuItem Header="Minimize window" Click="Minimize_Click" />
                                        <MenuItem Header="Hide dashboard" Click="CloseToTray_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="9" Height="9" Fill="{Binding MonitoringStatusColor}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding MonitoringStatusText}" Foreground="{DynamicResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource DimBrush}" FontSize="11" Margin="15,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="17" Padding="30" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="174" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="10,0,10,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="132" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="108" Height="108" CornerRadius="54" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusIcon}" Foreground="{DynamicResource TextBrush}" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusTitle}" Foreground="{DynamicResource TextBrush}" FontSize="40" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusSubtitle}" Foreground="{DynamicResource MutedBrush}" FontSize="26" FontWeight="Medium" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StatusDescription}" Foreground="{DynamicResource DimBrush}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Background="{DynamicResource PanelAltBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22,16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="82" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="72" Height="72" CornerRadius="36" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CountdownCaption}" Foreground="{DynamicResource MutedBrush}" FontSize="14" />
                                        <TextBlock Text="{Binding CountdownLabel}" Foreground="{DynamicResource TextBrush}" FontSize="48" FontWeight="SemiBold" Margin="0,1,0,0" />
                                        <TextBlock Text="{Binding CountdownFootnote}" Foreground="{DynamicResource DimBrush}" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                                        <Button Content="{Binding ActionNowLabel}" Click="ActionNow_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="24,15" MinWidth="214" Height="62" IsEnabled="{Binding CanExecuteActionNow}" ToolTip="Available while a power action is scheduled." />
                                        <Button Content="Cancel" Click="CancelAction_Click" Style="{StaticResource CardButtonStyle}" Padding="24,15" MinWidth="136" Height="62" Margin="18,0,0,0" IsEnabled="{Binding CanCancelAction}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.32*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Agents" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="View all  →" Tag="Agents" Click="Nav_Click" Style="{StaticResource CardButtonStyle}" Padding="11,7" FontSize="12" Foreground="{DynamicResource AccentBrush}" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding ActiveAgentSummary}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,8" />
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Agents}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                                    <Grid MinHeight="56">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="48" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Image Width="36" Height="36" Source="{Binding LogoPath}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Medium" />
                                                            <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24" Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Shutdown behavior" Foreground="{DynamicResource TextBrush}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Choose what happens when all agents are done." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,4,0,10" TextWrapping="Wrap" />
                                <RadioButton GroupName="CompletionBehavior" Tag="Shutdown" IsChecked="{Binding IsShutdownSelected, Mode=OneWay}" Click="CompletionBehavior_Click" Style="{StaticResource BehaviorRadioStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Shut down" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Medium" />
                                        <TextBlock Text="Power off your computer" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="CompletionBehavior" Tag="Sleep" IsChecked="{Binding IsSleepSelected, Mode=OneWay}" Click="CompletionBehavior_Click" Style="{StaticResource BehaviorRadioStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Sleep" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Medium" />
                                        <TextBlock Text="Put your computer to sleep" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton GroupName="CompletionBehavior" Tag="Delay" IsChecked="{Binding IsDelayedShutdownSelected, Mode=OneWay}" Click="CompletionBehavior_Click" Style="{StaticResource BehaviorRadioStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Delay 10 minutes" Foreground="{DynamicResource TextBrush}" FontSize="14" FontWeight="Medium" />
                                        <TextBlock Text="Wait 10 minutes, then shut down" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,10,0,9" />
                                <CheckBox x:Name="ShutdownOnlyOnAcCheckBox" Content="Only shut down if computer is on AC power" IsChecked="{Binding Settings.ShutdownOnlyOnAc, Mode=OneWay}" IsEnabled="{Binding IsShutdownOnlyOnAcEnabled}" Click="SettingChanged" Style="{StaticResource BehaviorCheckBoxStyle}" />
                                <CheckBox x:Name="FinalNotificationCheckBox" Content="Show a final notification before shutting down" IsChecked="{Binding Settings.ShowFinalNotificationBeforeAction, Mode=OneWay}" Click="SettingChanged" Style="{StaticResource BehaviorCheckBoxStyle}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="AgentsPanel" Grid.RowSpan="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="AGENTS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="Choose what counts as work" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="Built-in profiles cover common coding agents. Add a process when your stack is more custom." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Agents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="54" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="40" Height="40" Source="{Binding LogoPath}" Stretch="Uniform" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,10,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <CheckBox Content="Track" IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding Id}" Click="AgentEnabled_Click" Foreground="{DynamicResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" />
                                                <Button Content="Remove" Tag="{Binding Id}" Click="RemoveAgent_Click" Style="{StaticResource CardButtonStyle}" Visibility="{Binding Id, Converter={StaticResource CustomAgentVisibilityConverter}}" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="NewAgentNameTextBox" Style="{StaticResource InputStyle}" Margin="0,0,8,0" ToolTip="Display name" />
                            <TextBox x:Name="NewAgentProcessTextBox" Grid.Column="1" Style="{StaticResource InputStyle}" Margin="8,0,8,0" ToolTip="Process name, e.g. aider.exe" />
                            <Button Grid.Column="2" Content="Add agent" Click="AddAgent_Click" Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="SettingsPanel" Grid.RowSpan="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="SETTINGS" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="Make the finish line yours" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="The safe defaults are visible and reversible. Adjust how Agentoff keeps your computer available." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="After all agents stop" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Choose what Agentoff should do when the finish line is real." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,12" />
                                    <ComboBox x:Name="PowerActionComboBox" Style="{StaticResource SelectStyle}" SelectedValuePath="Tag" SelectionChanged="SettingSelectionChanged">
                                        <ComboBoxItem Content="Shut down the computer" Tag="Shutdown" />
                                        <ComboBoxItem Content="Hibernate" Tag="Hibernate" />
                                        <ComboBoxItem Content="Sleep" Tag="Sleep" />
                                        <ComboBoxItem Content="Lock the session" Tag="Lock" />
                                        <ComboBoxItem Content="Do nothing" Tag="DoNothing" />
                                    </ComboBox>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Grace period" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
                                            <ComboBox x:Name="GraceComboBox" Style="{StaticResource SelectStyle}" SelectedValuePath="Tag" SelectionChanged="SettingSelectionChanged">
                                                <ComboBoxItem Content="30 seconds" Tag="30" />
                                                <ComboBoxItem Content="90 seconds" Tag="90" />
                                                <ComboBoxItem Content="2 minutes" Tag="120" />
                                                <ComboBoxItem Content="5 minutes" Tag="300" />
                                                <ComboBoxItem Content="10 minutes" Tag="600" />
                                                <ComboBoxItem Content="15 minutes" Tag="900" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Countdown" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,6" />
                                            <ComboBox x:Name="CountdownComboBox" Style="{StaticResource SelectStyle}" SelectedValuePath="Tag" SelectionChanged="SettingSelectionChanged">
                                                <ComboBoxItem Content="15 seconds" Tag="15" />
                                                <ComboBoxItem Content="60 seconds" Tag="60" />
                                                <ComboBoxItem Content="2 minutes" Tag="120" />
                                                <ComboBoxItem Content="5 minutes" Tag="300" />
                                                <ComboBoxItem Content="10 minutes" Tag="600" />
                                                <ComboBoxItem Content="15 minutes" Tag="900" />
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Keep the machine awake" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Agentoff temporarily holds the system awake and restores lid settings when the session ends." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,12" TextWrapping="Wrap" />
                                    <CheckBox x:Name="KeepLidClosedCheckBox" Content="Keep awake even when the lid is closed" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="KeepAwakeAcCheckBox" Content="When plugged in" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,9" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <CheckBox x:Name="KeepAwakeBatteryCheckBox" Content="On battery too" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12" Checked="SettingChanged" Unchecked="SettingChanged" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Battery safety threshold" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBox x:Name="BatteryGuardTextBox" Style="{StaticResource InputStyle}" Width="54" Margin="12,0,6,0" TextChanged="SettingTextChanged" />
                                        <TextBlock Text="%" Foreground="{DynamicResource MutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Launch behavior" Foreground="{DynamicResource TextBrush}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Keep the monitor available without keeping the dashboard open." Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,12" />
                                    <CheckBox x:Name="StartupCheckBox" Content="Start Agentoff with Windows" Foreground="{DynamicResource TextBrush}" Checked="SettingChanged" Unchecked="SettingChanged" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="ActivityPanel" Grid.RowSpan="3" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,22">
                        <TextBlock Text="ACTIVITY" Foreground="{DynamicResource AccentBrush}" FontSize="10" FontWeight="SemiBold" />
                        <TextBlock Text="Know why the machine is awake" Foreground="{DynamicResource TextBrush}" FontSize="28" FontWeight="SemiBold" Margin="0,5,0,0" />
                        <TextBlock Text="Every state change is written plainly so an automatic power action never feels mysterious." Foreground="{DynamicResource MutedBrush}" FontSize="13" Margin="0,8,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="22">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Activity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="74" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding TimeLabel}" Foreground="{DynamicResource DimBrush}" FontSize="11" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{DynamicResource TextBrush}" FontSize="13" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
          </Grid>
        </Grid>
        </Viewbox>
    </Border>
</Window>
