<Window x:Class="Spreek.FlowBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spreek Flow Bar"
        Width="420"
        Height="58"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        Topmost="True"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded">
    <Border x:Name="Shell"
            Background="#F8111722"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="24"
            Padding="16,10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="22" ShadowDepth="5" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Width="34" Height="34" VerticalAlignment="Center">
                <Ellipse x:Name="StateRing" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Opacity="0.6" />
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Height="32" Margin="13,0,14,0" VerticalAlignment="Center">
                <Border x:Name="Level1" Width="3" Height="7" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <Border x:Name="Level2" Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <Border x:Name="Level3" Width="3" Height="21" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <Border x:Name="Level4" Width="3" Height="13" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,3,0" />
                <Border x:Name="Level5" Width="3" Height="7" CornerRadius="2" Background="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusText"
                               Text="Ready"
                               FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ElapsedText"
                               Text=""
                               Foreground="{StaticResource MutedBrush}"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="12"
                               Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="InterimText"
                           Grid.Row="1"
                           Text="Hold Ctrl + Win to dictate"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="285"
                           Margin="0,2,0,0" />
            </Grid>

            <StackPanel x:Name="ActionPanel" Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="RetryButton" Content="Retry" Style="{StaticResource SuccessButton}" Padding="10,5" MinHeight="30" Margin="0,0,6,0" Visibility="Collapsed" Click="OnRetry" />
                <Button x:Name="CopyButton" Content="Copy" Style="{StaticResource CompactButton}" Margin="0,0,6,0" Visibility="Collapsed" Click="OnCopy" />
                <Button x:Name="StopButton" Content="Stop" Style="{StaticResource PrimaryButton}" Padding="10,5" MinHeight="30" Margin="0,0,6,0" Visibility="Collapsed" Click="OnStop" />
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}" Padding="10,5" MinHeight="30" Visibility="Collapsed" Click="OnCancel" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
