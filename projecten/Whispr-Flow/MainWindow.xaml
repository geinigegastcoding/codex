<Window x:Class="InsideySpeak.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insidey Speak"
        Width="1320"
        Height="820"
        MinWidth="1100"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        Topmost="True"
        ShowActivated="False"
        KeyDown="Window_KeyDown"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#17213B" />
        <SolidColorBrush x:Key="Muted" Color="#7B88A4" />
        <SolidColorBrush x:Key="Border" Color="#E1E7F1" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="SoftPanel" Color="#F1F4FB" />
        <SolidColorBrush x:Key="Accent" Color="#5B5CEB" />

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#61708F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="12,11" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E7E9FF" />
                                <Setter Property="Foreground" Value="#4547D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#D9DBFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#71809D" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E9ECF5" />
                                <Setter Property="Foreground" Value="#4D5B7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#5B5CEB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4B4CD4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3C3DBB" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="#A9AED1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#F0F3FA" />
            <Setter Property="Foreground" Value="#53617E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#E1E5F3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9AA6BE" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,7" />
        </Style>

        <Style x:Key="FlowCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#394762" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,7,0,0" />
        </Style>

        <Style x:Key="FieldBox" TargetType="Control">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="Shell" Background="#F7F9FD" BorderBrush="#DCE4F0" BorderThickness="1" CornerRadius="25">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="78" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="84" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#FBFCFF" CornerRadius="25,25,0,0">
                    <Grid Margin="27,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="42" Height="42" Background="#E9E7FF" CornerRadius="14">
                                <TextBlock Text="✦" Foreground="#5B5CEB" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Insidey Speak" Foreground="#17213B" FontSize="19" FontWeight="SemiBold" />
                                <TextBlock Text="Your voice, in the flow" Foreground="#8A96AE" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="#EFF7F3" CornerRadius="12" Padding="11,7" Margin="0,0,14,0">
                                <TextBlock x:Name="ConnectionText" Text="Deepgram · not tested" Foreground="#32815C" FontSize="11" />
                            </Border>
                            <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="—" ToolTip="Hide to tray" Click="MinimizeButton_Click" />
                            <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="×" FontSize="21" ToolTip="Hide to tray" Click="CloseButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#EFF3FB" CornerRadius="18" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="WORKSPACE" Style="{StaticResource SectionLabel}" Margin="0,2,0,8" />
                                <Button x:Name="NavDictate" Style="{StaticResource NavButton}" Background="#E4E6FF" Foreground="#4B4CD4" Click="NavDictate_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="♩" FontSize="18" Width="30" /><TextBlock Text="Dictate" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="NavTranscripts" Style="{StaticResource NavButton}" Click="NavTranscripts_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="▤" FontSize="17" Width="30" /><TextBlock Text="Transcripts" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="NavVocabulary" Style="{StaticResource NavButton}" Click="NavVocabulary_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="19" Width="30" /><TextBlock Text="Vocabulary" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Click="NavSettings_Click">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="17" Width="30" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Separator Margin="0,17,0,3" Background="#DCE3F1" />
                                <TextBlock Text="RECENT" Style="{StaticResource SectionLabel}" Margin="0,8,0,7" />
                                <ListBox x:Name="HistoryListBox" Height="190" Background="Transparent" BorderThickness="0" Foreground="#53617E" FontSize="11" SelectionChanged="HistoryListBox_SelectionChanged" />
                                <TextBlock x:Name="HistoryEmptyText" Text="Your latest dictation will stay here." Foreground="#A4AEC1" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                            </StackPanel>

                            <Border Grid.Row="1" Background="#E8EDFB" CornerRadius="14" Padding="12" Margin="0,14,0,14">
                                <StackPanel>
                                    <TextBlock Text="Talk naturally." Foreground="#3D4E74" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="We clean the noise and paste the result where you were working." Foreground="#8190AF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <TextBlock Grid.Row="2" Text="LOCAL WORKSPACE  ·  v0.1" Foreground="#9BA7BC" FontSize="10" />
                        </Grid>
                    </Border>

                    <Grid Grid.Column="1" Margin="14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="58" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Untitled transcript" Foreground="#1B2745" FontSize="21" FontWeight="SemiBold" />
                                <TextBlock x:Name="DocumentStatus" Text="Ready when you are" Foreground="#8995AD" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" Content="Copy" Click="CopyButton_Click" />
                                <Button x:Name="PasteLastButton" Style="{StaticResource SecondaryButton}" Content="Paste last" Margin="7,0,0,0" Click="PasteLastButton_Click" />
                                <Button x:Name="QuickNoteButton" Style="{StaticResource SecondaryButton}" Content="Quick note" Margin="7,0,0,0" Click="QuickNoteButton_Click" />
                                <Button x:Name="SaveHistoryEditButton" Style="{StaticResource SecondaryButton}" Content="Save edit" Margin="7,0,0,0" Click="SaveHistoryEditButton_Click" />
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E4E9F3" BorderThickness="1" CornerRadius="18" Padding="30">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Good to have you here." Foreground="#17213B" FontSize="27" FontWeight="SemiBold" />
                                    <TextBlock Text="Start talking. I’ll handle the rest." Foreground="#9AA7C4" FontSize="26" Margin="0,3,0,0" />
                                </StackPanel>

                                <Grid Grid.Row="1" Margin="0,28,0,0">
                                    <TextBlock x:Name="TranscriptPlaceholder" Text="Your cleaned transcript will appear here..." Foreground="#B8C1D3" FontSize="17" TextWrapping="Wrap" IsHitTestVisible="False" Margin="0,4,0,0" />
                                    <TextBox x:Name="TranscriptBox" AutomationProperties.Name="Transcript editor" TextChanged="TranscriptBox_TextChanged" Background="Transparent" BorderThickness="0" Foreground="#293653" FontSize="17" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="0" />
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,16,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="ToolbarCopyButton" Style="{StaticResource SecondaryButton}" Content="✦  Copy text" Click="CopyButton_Click" />
                                        <Button x:Name="ToolbarClearButton" Style="{StaticResource SecondaryButton}" Content="Clear" Margin="7,0,0,0" Click="ClearButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="WordCountText" Text="0 words" Foreground="#9AA7C4" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E4E9F3" BorderThickness="1" CornerRadius="18" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Assist" Foreground="#17213B" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Make the next thought effortless." Foreground="#8B97AF" FontSize="12" Margin="0,3,0,13" />

                                <Border x:Name="ListenCard" Background="#F0F0FF" CornerRadius="14" Padding="13" Margin="0,0,0,9">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="ListenIcon" Width="32" Height="32" Background="#FFFFFF" CornerRadius="10">
                                                <TextBlock x:Name="ListenIconText" Text="♩" Foreground="#5B5CEB" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="PanelStatusText" Text="Ready to dictate" Foreground="#293653" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock x:Name="PanelStatusDetail" Text="Press the shortcut or button" Foreground="#8490AA" FontSize="10" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="RecordButton" AutomationProperties.Name="Start dictation" Style="{StaticResource PrimaryButton}" Content="Start dictation" Margin="0,13,0,0" Click="RecordButton_Click" />
                                        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="Cancel" Visibility="Collapsed" Margin="0,7,0,0" Click="CancelButton_Click" />
                                        <TextBlock Text="Ctrl + Shift + Space" Foreground="#6A70D9" FontSize="10" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="AUTOMATION" Style="{StaticResource SectionLabel}" />
                                <CheckBox x:Name="AutoPasteCheckBox" Style="{StaticResource FlowCheckBox}" Content="Paste into the active app" IsChecked="True" />
                                <CheckBox x:Name="FilterFillersCheckBox" Style="{StaticResource FlowCheckBox}" Content="Filter filler words" IsChecked="True" />
                                <CheckBox x:Name="SpokenPunctuationCheckBox" Style="{StaticResource FlowCheckBox}" IsChecked="True">
                                    <TextBlock Text="Spoken punctuation (comma / period)" TextWrapping="Wrap" MaxWidth="245" />
                                </CheckBox>
                                <CheckBox x:Name="PressEnterCheckBox" Style="{StaticResource FlowCheckBox}" Content="Press Enter when spoken at the end" />
                                <CheckBox x:Name="StartWithWindowsCheckBox" Style="{StaticResource FlowCheckBox}" Content="Start with Windows" />

                                <TextBlock Text="DEEPGRAM" Style="{StaticResource SectionLabel}" />
                                <PasswordBox x:Name="ApiKeyBox" AutomationProperties.Name="Deepgram API key" Background="#F5F7FB" BorderBrush="#E2E7F1" BorderThickness="1" Padding="10,8" Margin="0,0,0,8" />
                                <StackPanel>
                                    <Button x:Name="SaveSettingsButton" Style="{StaticResource SecondaryButton}" Content="Save settings" Click="SaveSettingsButton_Click" />
                                    <Button x:Name="TestConnectionButton" Style="{StaticResource SecondaryButton}" Content="Test connection" Margin="0,7,0,0" Click="TestConnectionButton_Click" />
                                </StackPanel>
                                <TextBlock Text="You can also set DEEPGRAM_API_KEY. Saved keys are protected by Windows." Foreground="#9AA6BE" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />

                                <TextBlock Text="TOOLS" Style="{StaticResource SectionLabel}" />
                                <Button x:Name="RetryLastButton" Style="{StaticResource SecondaryButton}" Content="Retry saved recording" Click="RetryLastButton_Click" />
                                <Button x:Name="PasteLastRailButton" Style="{StaticResource SecondaryButton}" Content="Paste last transcript" Margin="0,7,0,0" Click="PasteLastButton_Click" />
                                <Button x:Name="PlayAudioButton" Style="{StaticResource SecondaryButton}" Content="Play selected recording" Margin="0,7,0,0" IsEnabled="False" Click="PlayAudioButton_Click" />
                                <Button x:Name="ExportHistoryButton" Style="{StaticResource SecondaryButton}" Content="Export history" Margin="0,7,0,0" Click="ExportHistoryButton_Click" />
                                <Button x:Name="DeleteHistoryButton" Style="{StaticResource SecondaryButton}" Content="Delete selected transcript" Margin="0,7,0,0" Click="DeleteHistoryButton_Click" />

                                <TextBlock Text="DICTIONARY" Style="{StaticResource SectionLabel}" />
                                <TextBox x:Name="DictionaryBox" AutomationProperties.Name="Dictionary entries" Height="95" Background="#F5F7FB" BorderBrush="#E2E7F1" BorderThickness="1" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                                <TextBlock Text="One term per line, or use spoken =&gt; replacement. Terms are sent to Deepgram as keyterms." Foreground="#9AA6BE" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Button x:Name="ImportDictionaryButton" Style="{StaticResource SecondaryButton}" Content="Import dictionary CSV" Margin="0,7,0,0" Click="ImportDictionaryButton_Click" />

                                <TextBlock Text="SNIPPETS" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="SnippetSelector" AutomationProperties.Name="Snippet selector" DisplayMemberPath="Name" Background="#F5F7FB" BorderBrush="#E2E7F1" Padding="8,5" />
                                <Button x:Name="InsertSnippetButton" Style="{StaticResource SecondaryButton}" Content="Insert selected snippet" Margin="0,7,0,0" Click="InsertSnippetButton_Click" />
                                <TextBox x:Name="SnippetsBox" AutomationProperties.Name="Snippet definitions" Height="76" Background="#F5F7FB" BorderBrush="#E2E7F1" BorderThickness="1" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0" />
                                <TextBlock Text="One per line: name =&gt; text" Foreground="#9AA6BE" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                                <Button x:Name="ImportSnippetsButton" Style="{StaticResource SecondaryButton}" Content="Import snippets JSON" Margin="0,7,0,0" Click="ImportSnippetsButton_Click" />

                                <TextBlock Text="MICROPHONE" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="MicrophoneBox" AutomationProperties.Name="Microphone device" SelectedValuePath="Tag" Background="#F5F7FB" BorderBrush="#E2E7F1" Padding="8,5" />

                                <TextBlock Text="LANGUAGE" Style="{StaticResource SectionLabel}" />
                                <ComboBox x:Name="LanguageBox" AutomationProperties.Name="Transcription language" IsEditable="True" SelectedValuePath="Tag" Background="#F5F7FB" BorderBrush="#E2E7F1" Padding="8,5">
                                    <ComboBoxItem Content="English (US)" Tag="en-US" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                    <ComboBoxItem Content="Dutch" Tag="nl" />
                                    <ComboBoxItem Content="German" Tag="de" />
                                    <ComboBoxItem Content="French" Tag="fr" />
                                    <ComboBoxItem Content="Spanish" Tag="es" />
                                    <ComboBoxItem Content="Chinese" Tag="zh" />
                                    <ComboBoxItem Content="Japanese" Tag="ja" />
                                    <ComboBoxItem Content="Korean" Tag="ko" />
                                    <ComboBoxItem Content="Multilingual" Tag="multi" />
                                </ComboBox>
                                <TextBlock Text="Choose a preset or type any Deepgram language code." Foreground="#9AA6BE" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Margin="18,0,18,18" Background="#151D2D" CornerRadius="20">
                    <Grid Margin="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="BarMic" Width="42" Height="42" Background="#E7E7FF" CornerRadius="14">
                                <TextBlock x:Name="BarMicText" Text="♩" Foreground="#5B5CEB" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="BarStateText" Text="Ready to capture" Foreground="#FFFFFF" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Ctrl + Shift + Space  ·  starts/stops dictation" Foreground="#9DAAC4" FontSize="10" Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="Waveform" Orientation="Horizontal" Width="168" Height="34" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            <TextBlock x:Name="ElapsedText" Text="00:00" Foreground="#A5B0C7" FontSize="11" Width="40" TextAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
